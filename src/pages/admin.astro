---
import lakorns from "../data/lakorns.json";
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Адмін-панель | Volyacore</title>
    <style>
      body {
        font-family:
          system-ui,
          -apple-system,
          sans-serif;
        background-color: #0f172a;
        color: #fff;
        margin: 0;
        padding: 0;
        height: 100vh;
        overflow: hidden;
      }
      .hidden {
        display: none !important;
      }

      #login-screen {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
      }
      .login-box {
        width: 100%;
        max-width: 400px;
        background-color: #1e293b;
        padding: 30px;
        border-radius: 16px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
      }

      #admin-panel {
        display: flex;
        height: 100vh;
        width: 100vw;
        overflow: hidden;
      }
      aside {
        width: 320px;
        background-color: #1e293b;
        border-right: 1px solid #334155;
        padding: 20px;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        gap: 15px;
        height: 100vh;
        overflow: hidden;
      }
      main {
        flex: 1;
        padding: 30px;
        box-sizing: border-box;
        height: 100vh;
        overflow-y: auto;
        display: flex;
        justify-content: center;
      }
      .form-container {
        width: 100%;
        max-width: 700px;
        background-color: #1e293b;
        padding: 30px;
        border-radius: 16px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
        height: fit-content;
        margin-bottom: 50px;
      }

      h2,
      h3 {
        margin-top: 0;
        color: #f8fafc;
      }

      .btn-new {
        background-color: #10b981;
        color: white;
        border: none;
        padding: 10px;
        border-radius: 8px;
        cursor: pointer;
        width: 100%;
        font-weight: 600;
        transition: background 0.2s;
        flex-shrink: 0;
      }
      .btn-new:hover {
        background-color: #059669;
      }

      .sidebar-search-container {
        display: flex;
        flex-direction: column;
        gap: 10px;
        flex-shrink: 0;
      }

      .search-input {
        width: 100%;
        padding: 8px 12px;
        background: #0f172a;
        border: 1px solid #334155;
        border-radius: 8px;
        color: #fff;
        font-size: 13px;
        box-sizing: border-box;
        outline: none;
      }
      .search-input:focus {
        border-color: #6366f1;
      }

      #lakorn-list-container {
        display: flex;
        flex-direction: column;
        gap: 8px;
        overflow-y: auto;
        flex: 1;
        padding-right: 4px;
      }

      .lakorn-item {
        padding: 10px 12px;
        background: #0f172a;
        border-radius: 8px;
        cursor: pointer;
        border: 1px solid #334155;
        transition: all 0.2s;
        font-size: 14px;
      }
      .lakorn-item:hover,
      .lakorn-item.active {
        border-color: #6366f1;
        background: #172033;
      }

      label {
        display: block;
        font-size: 12px;
        font-weight: 700;
        color: #94a3b8;
        text-transform: uppercase;
        margin-bottom: 4px;
        letter-spacing: 0.5px;
        margin-top: 12px;
      }
      input,
      textarea,
      select {
        width: 100%;
        padding: 10px 12px;
        background-color: #0f172a;
        border: 1px solid #334155;
        color: #fff;
        border-radius: 8px;
        box-sizing: border-box;
        font-size: 14px;
        outline: none;
      }
      textarea {
        resize: vertical;
        height: 80px;
      }
      input:focus,
      textarea:focus,
      select:focus {
        border-color: #6366f1;
      }

      .seasons-box {
        background: #0f172a;
        padding: 15px;
        border-radius: 8px;
        border: 1px solid #334155;
        margin-top: 10px;
      }
      .season-row {
        display: flex;
        gap: 10px;
        margin-bottom: 8px;
        align-items: center;
      }
      .season-row input {
        margin-bottom: 0;
      }
      .btn-del-season {
        background: #ef4444;
        color: white;
        border: none;
        padding: 8px 12px;
        border-radius: 6px;
        cursor: pointer;
      }
      .btn-add-season {
        background: #3b82f6;
        color: white;
        border: none;
        padding: 8px 12px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 13px;
        margin-top: 5px;
      }

      button[type="submit"] {
        background-color: #6366f1;
        color: white;
        border: none;
        padding: 12px;
        border-radius: 8px;
        cursor: pointer;
        width: 100%;
        font-weight: 600;
        font-size: 15px;
        margin-top: 20px;
        transition: background 0.2s;
      }
      button[type="submit"]:hover {
        background-color: #4f46e5;
      }

      .error {
        color: #f87171;
        font-size: 14px;
        margin-top: 10px;
        text-align: center;
      }
      .success {
        color: #4ade80;
        font-size: 14px;
        margin-top: 10px;
        text-align: center;
        font-weight: 500;
      }
    </style>
  </head>
  <body>
    <!-- ЕКРАН АВТОРИЗАЦІЇ -->
    <div id="login-screen">
      <div class="login-box">
        <h2>Вхід в адмінку</h2>
        <input type="password" id="admin-pass" placeholder="Введіть пароль" />
        <button
          id="login-btn"
          style="margin-top: 15px; background: #6366f1; color: white; border: none; padding: 10px; width: 100%; border-radius: 8px; cursor: pointer;"
          >Увійти</button
        >
        <p id="login-error" class="error hidden">Невірний пароль!</p>
      </div>
    </div>

    <div id="admin-panel" class="hidden">
      <aside>
        <h3>Проєкти</h3>
        <button class="btn-new" id="btn-create-new">+ Новий лакорн</button>

        <div class="sidebar-search-container">
          <input
            type="text"
            id="project-search-input"
            placeholder="Пошук за назвою..."
            class="search-input"
          />
        </div>

        <div id="lakorn-list-container">
          {
            lakorns.map((item: any) => (
              <div
                class="lakorn-item"
                data-id={item.id}
                data-title={item.title.toLowerCase()}
                data-genres={
                  Array.isArray(item.genres)
                    ? item.genres.join(",")
                    : item.genres || ""
                }
                data-country={item.country || ""}
              >
                {item.title}
              </div>
            ))
          }
        </div>
      </aside>

      <main>
        <div class="form-container">
          <h2 id="form-title">Додати новий лакорн</h2>
          <form id="lakorn-form">
            <input type="hidden" id="currentCover" value="" />
            <label>ID (англійською без пробілів):</label>
            <input type="text" id="id" required placeholder="perfect10liners" />

            <label>Назва українською:</label>
            <input
              type="text"
              id="title"
              required
              placeholder="Бездоганна десятка"
            />

            <label>Оригінальна / англійська назва:</label>
            <input
              type="text"
              id="enTitle"
              placeholder="Perfect 10 Liners / สายรหัสเทวดา"
            />

            <label>Опис:</label>
            <textarea id="description" placeholder="Короткий опис сюжету..."
            ></textarea>

            <label>Завантажити файл обкладинки ( JPG / PNG ):</label>
            <input type="file" id="coverFile" accept="image/*" />

            <label>АБО пряме посилання на картинку:</label>
            <input
              type="text"
              id="coverUrl"
              placeholder="https://.../image.jpg"
            />

            <label>Статус (completed / ongoing):</label>
            <input type="text" id="status" value="completed" />

            <label>Країна:</label>
            <select id="country">
              <option value="thailand">Таїланд</option>
              <option value="korea">Південна Корея</option>
              <option value="japan">Японія</option>
              <option value="china">Китай</option>
              <option value="taiwan">Тайвань</option>
              <option value="singapore">Сінгапур</option>
              <option value="philippines">Філіппіни</option>
            </select>

            <label>Категорія (наприклад, BL):</label>
            <input type="text" id="categories" value="BL" />

            <label>Рік:</label>
            <input type="number" id="year" value="2024" />

            <label>Жанри:</label>
            <select id="genres-select" style="margin-bottom: 8px;">
              <option value="">-- Додати жанр зі списку --</option>
              <option value="romance">Романтика</option>
              <option value="drama">Драма</option>
              <option value="detective">Детектив</option>
              <option value="comedy">Комедія</option>
              <option value="crime">Кримінал</option>
              <option value="sports">Спорт</option>
              <option value="music">Музика</option>
              <option value="routine">Буденність</option>
              <option value="fantasy">Фентезі</option>
              <option value="fantastic">Фантастика</option>
              <option value="action">Бойовик</option>
              <option value="horrors">Жахи</option>
              <option value="supernatural">Надприродне</option>
              <option value="thriller">Триллер</option>
              <option value="mysticism">Містика</option>
              <option value="youth">Юність</option>
              <option value="law">Закон</option>
              <option value="melodrama">Мелодрама</option>
              <option value="business">Бізнес</option>
              <option value="food">Страви</option>
              <option value="medical">Медицина</option>
              <option value="historical">Історичне</option>
              <option value="psychological">Психологія</option>
              <option value="life">Життя</option>
              <option value="slice of life">Повседневність</option>
              <option value="fashion film">Фешн-фільм</option>
              <option value="adult">Для дорослих</option>
              <option value="sci-fi">Наукова Фантастика</option>
              <option value="anime">Аніме</option>
            </select>
            <input
              type="text"
              id="genres"
              value="romance, comedy"
              placeholder="romance, comedy"
            />

            <label>Рейтинг:</label>
            <input type="text" id="imdbRating" placeholder="7.9" />

            <label>Тривалість серії:</label>
            <input type="text" id="duration" placeholder="45 хв" />

            <label>Актори (через кому):</label>
            <input type="text" id="cast" placeholder="Актор 1, Актор 2" />

            <label>Режисер:</label>
            <input type="text" id="director" placeholder="" />

            <label>Мережа (Network):</label>
            <input type="text" id="network" placeholder="GMMTV" />

            <label>Кількість серій:</label>
            <input type="number" id="episodesCount" placeholder="12" />

            <label>Посилання на серії (Telegram ID):</label>
            <div class="seasons-box" id="episodes-container"></div>
            <button
              type="button"
              class="btn-add-season"
              id="btn-add-episode"
              style="background: #10b981;">+ Додати серію</button
            >

            <label>Спецвипуски:</label>
            <div class="seasons-box" id="special-episodes-container"></div>
            <button
              type="button"
              class="btn-add-season"
              id="btn-add-special-episode"
              style="background: #8b5cf6;"
            >
              + Додати спецвипуск
            </button>

            <label>Пов'язані сезони (Сезони / Частини):</label>
            <div class="seasons-box" id="seasons-container"></div>
            <button type="button" class="btn-add-season" id="btn-add-season"
              >+ Додати сезон</button
            >

            <button type="submit" id="submit-btn">Зберегти на GitHub</button>
            <p id="status-msg"></p>
          </form>
        </div>
      </main>
    </div>

