---
import lakorns from "../data/lakorns.json";
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Адмін-панель | Volyacore</title>
    <style>
      body {
        font-family: system-ui, -apple-system, sans-serif;
        background-color: #0f172a;
        color: #fff;
        margin: 0;
        padding: 0;
        height: 100vh;
        overflow: hidden;
      }
      .hidden {
        display: none !important;
      }

      #login-screen {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
      }
      .login-box {
        width: 100%;
        max-width: 400px;
        background-color: #1e293b;
        padding: 30px;
        border-radius: 16px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
      }

      #admin-panel {
        display: flex;
        height: 100vh;
        width: 100vw;
        overflow: hidden;
      }
      aside {
        width: 320px;
        background-color: #1e293b;
        border-right: 1px solid #334155;
        padding: 20px;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        gap: 15px;
        height: 100vh;
        overflow: hidden;
      }
      main {
        flex: 1;
        padding: 30px;
        box-sizing: border-box;
        height: 100vh;
        overflow-y: auto;
        display: flex;
        justify-content: center;
      }
      .form-container {
        width: 100%;
        max-width: 700px;
        background-color: #1e293b;
        padding: 30px;
        border-radius: 16px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
        height: fit-content;
        margin-bottom: 50px;
      }

      h2, h3 {
        margin-top: 0;
        color: #f8fafc;
      }

      .btn-new {
        background-color: #10b981;
        color: white;
        border: none;
        padding: 10px;
        border-radius: 8px;
        cursor: pointer;
        width: 100%;
        font-weight: 600;
        transition: background 0.2s;
        flex-shrink: 0;
      }
      .btn-new:hover {
        background-color: #059669;
      }

      .sidebar-search-container {
        display: flex;
        flex-direction: column;
        gap: 10px;
        flex-shrink: 0;
      }

      .search-input {
        width: 100%;
        padding: 8px 12px;
        background: #0f172a;
        border: 1px solid #334155;
        border-radius: 8px;
        color: #fff;
        font-size: 13px;
        box-sizing: border-box;
        outline: none;
      }
      .search-input:focus {
        border-color: #6366f1;
      }

      #lakorn-list-container {
        display: flex;
        flex-direction: column;
        gap: 8px;
        overflow-y: auto;
        flex: 1;
        padding-right: 4px;
      }

      .lakorn-item {
        padding: 10px 12px;
        background: #0f172a;
        border-radius: 8px;
        cursor: pointer;
        border: 1px solid #334155;
        transition: all 0.2s;
        font-size: 14px;
      }
      .lakorn-item:hover,
      .lakorn-item.active {
        border-color: #6366f1;
        background: #172033;
      }

      label {
        display: block;
        font-size: 12px;
        font-weight: 700;
        color: #94a3b8;
        text-transform: uppercase;
        margin-bottom: 4px;
        letter-spacing: 0.5px;
        margin-top: 12px;
      }
      input,
      textarea,
      select {
        width: 100%;
        padding: 10px 12px;
        background-color: #0f172a;
        border: 1px solid #334155;
        color: #fff;
        border-radius: 8px;
        box-sizing: border-box;
        font-size: 14px;
        outline: none;
      }
      textarea {
        resize: vertical;
        height: 80px;
      }
      input:focus,
      textarea:focus,
      select:focus {
        border-color: #6366f1;
      }

      .episodes-box, .seasons-box {
        background: #0f172a;
        padding: 15px;
        border-radius: 8px;
        border: 1px solid #334155;
        margin-top: 10px;
      }
      .episode-row, .season-row {
        display: flex;
        gap: 10px;
        margin-bottom: 8px;
        align-items: center;
      }
      .episode-row input, .season-row input {
        margin-bottom: 0;
      }
      .btn-del-ep, .btn-del-season {
        background: #ef4444;
        color: white;
        border: none;
        padding: 8px 12px;
        border-radius: 6px;
        cursor: pointer;
      }
      .btn-add-ep, .btn-add-season {
        background: #3b82f6;
        color: white;
        border: none;
        padding: 8px 12px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 13px;
        margin-top: 5px;
      }

      button[type="submit"] {
        background-color: #6366f1;
        color: white;
        border: none;
        padding: 12px;
        border-radius: 8px;
        cursor: pointer;
        width: 100%;
        font-weight: 600;
        font-size: 15px;
        margin-top: 20px;
        transition: background 0.2s;
      }
      button[type="submit"]:hover {
        background-color: #4f46e5;
      }

      .error {
        color: #f87171;
        font-size: 14px;
        margin-top: 10px;
        text-align: center;
      }
      .success {
        color: #4ade80;
        font-size: 14px;
        margin-top: 10px;
        text-align: center;
        font-weight: 500;
      }
    </style>
  </head>
  <body>
    <!-- ЕКРАН АВТОРИЗАЦІЇ -->
    <div id="login-screen">
      <div class="login-box">
        <h2>Вхід в адмінку</h2>
        <input type="password" id="admin-pass" placeholder="Введіть пароль" />
        <button
          id="login-btn"
          style="margin-top: 15px; background: #6366f1; color: white; border: none; padding: 10px; width: 100%; border-radius: 8px; cursor: pointer;"
          >Увійти</button
        >
        <p id="login-error" class="error hidden">Невірний пароль!</p>
      </div>
    </div>

    <!-- ПАНЕЛЬ КЕРУВАННЯ -->
    <div id="admin-panel" class="hidden">
      <aside>
        <h3>Проєкти</h3>
        <button class="btn-new" id="btn-create-new">+ Новий лакорн</button>
        
        <div class="sidebar-search-container">
          <input 
            type="text" 
            id="project-search-input" 
            placeholder="Пошук за назвою..." 
            class="search-input"
          />
        </div>

        <div id="lakorn-list-container">
          {
            lakorns.map((item: any) => (
              <div class="lakorn-item" data-id={item.id} data-title={item.title.toLowerCase()} data-genres={Array.isArray(item.genres) ? item.genres.join(",") : (item.genres || "")} data-country={item.country || ""}>
                {item.title}
              </div>
            ))
          }
        </div>
      </aside>

      <main>
        <div class="form-container">
          <h2 id="form-title">Додати новий лакорн</h2>
          <form id="lakorn-form">
            <label>ID (англійською без пробілів):</label>
            <input type="text" id="id" required placeholder="perfect10liners" />

            <label>Назва українською:</label>
            <input
              type="text"
              id="title"
              required
              placeholder="Бездоганна десятка"
            />

            <label>Оригінальна / англійська назва:</label>
            <input
              type="text"
              id="enTitle"
              placeholder="Perfect 10 Liners / สายรหัสเทวดา"
            />

            <label>Опис:</label>
            <textarea id="description" placeholder="Короткий опис сюжету..."
            ></textarea>

            <label>Завантажити файл обкладинки ( JPG / PNG ):</label>
            <input type="file" id="coverFile" accept="image/*" />

            <label>АБО пряме посилання на картинку:</label>
            <input
              type="text"
              id="coverUrl"
              placeholder="https://.../image.jpg"
            />

            <label>Статус (completed / ongoing):</label>
            <input type="text" id="status" value="completed" />

            <label>Країна:</label>
            <select id="country">
              <option value="thailand">Таїланд</option>
              <option value="korea">Південна Корея</option>
              <option value="japan">Японія</option>
              <option value="china">Китай</option>
              <option value="taiwan">Тайвань</option>
              <option value="singapore">Сінгапур</option>
              <option value="philippines">Філіппіни</option>
            </select>

            <label>Категорія (наприклад, BL):</label>
            <input type="text" id="categories" value="BL" />

            <label>Рік:</label>
            <input type="number" id="year" value="2024" />

            <label>Жанри:</label>
            <select id="genres-select" style="margin-bottom: 8px;">
              <option value="">-- Додати жанр зі списку --</option>
              <option value="romance">Романтика</option>
              <option value="drama">Драма</option>
              <option value="detective">Детектив</option>
              <option value="comedy">Комедія</option>
              <option value="crime">Кримінал</option>
              <option value="sports">Спорт</option>
              <option value="music">Музика</option>
              <option value="routine">Буденність</option>
              <option value="fantasy">Фентезі</option>
              <option value="fantastic">Фантастика</option>
              <option value="action">Бойовик</option>
              <option value="horrors">Жахи</option>
              <option value="supernatural">Надприродне</option>
              <option value="thriller">Триллер</option>
              <option value="mysticism">Містика</option>
              <option value="youth">Юність</option>
              <option value="law">Закон</option>
              <option value="melodrama">Мелодрама</option>
              <option value="business">Бізнес</option>
              <option value="food">Страви</option>
              <option value="medical">Медицина</option>
              <option value="historical">Історичне</option>
              <option value="psychological">Психологія</option>
              <option value="life">Життя</option>
              <option value="slice of life">Повседневність</option>
              <option value="fashion film">Фешн-фільм</option>
              <option value="adult">Для дорослих</option>
              <option value="sci-fi">Наукова Фантастика</option>
              <option value="anime">Аніме</option>
            </select>
            <input type="text" id="genres" value="romance, comedy" placeholder="romance, comedy" />

            <label>Рейтинг IMDb:</label>
            <input type="text" id="imdbRating" value="7.9" />

            <label>Тривалість серії:</label>
            <input type="text" id="duration" value="45 хв" />

            <label>Актори (через кому):</label>
            <input type="text" id="cast" value="Актор 1, Актор 2" />

            <label>Режисер:</label>
            <input type="text" id="director" value="" />

            <label>Мережа (Network):</label>
            <input type="text" id="network" value="GMMTV" />

            <!-- СЕКЦІЯ: Пов'язані сезони / частини -->
            <label>Пов'язані сезони (Сезони / Частини):</label>
            <div class="seasons-box" id="seasons-container"></div>
            <button type="button" class="btn-add-season" id="btn-add-season">+ Додати сезон</button>

            <label>Серії (Telegram ID / Посилання):</label>
            <div class="episodes-box" id="episodes-container"></div>
            <button type="button" class="btn-add-ep" id="btn-add-episode">+ Додати серію</button>

            <button type="submit" id="submit-btn">Зберегти на GitHub</button>
            <p id="status-msg"></p>
          </form>
        </div>
      </main>
    </div>

    <script define:vars={{ existingLakorns: lakorns }}>
      const ADMIN_PASSWORD = "751641951";

      const loginScreen = document.getElementById("login-screen");
      const adminPanel = document.getElementById("admin-panel");
      const loginBtn = document.getElementById("login-btn");
      const adminPass = document.getElementById("admin-pass");
      const loginError = document.getElementById("login-error");

      if (sessionStorage.getItem("isAuth") === "true") {
        loginScreen.classList.add("hidden");
        adminPanel.classList.remove("hidden");
      }

      loginBtn.addEventListener("click", () => {
        if (adminPass.value === ADMIN_PASSWORD) {
          sessionStorage.setItem("isAuth", "true");
          loginScreen.classList.add("hidden");
          adminPanel.classList.remove("hidden");
        } else {
          loginError.classList.remove("hidden");
        }
      });

      const items = document.querySelectorAll(".lakorn-item");
      const btnCreateNew = document.getElementById("btn-create-new");
      const formTitle = document.getElementById("form-title");
      const form = document.getElementById("lakorn-form");
      const episodesContainer = document.getElementById("episodes-container");
      const btnAddEpisode = document.getElementById("btn-add-episode");

      const seasonsContainer = document.getElementById("seasons-container");
      const btnAddSeason = document.getElementById("btn-add-season");
      
      const searchInput = document.getElementById("project-search-input");
      const genresSelect = document.getElementById("genres-select");
      const genresInput = document.getElementById("genres");

      let selectedGenres = new Set();
      let selectedCountries = new Set();

      function filterSidebarItems() {
        const query = searchInput.value.toLowerCase().trim();
        items.forEach(item => {
          const title = item.getAttribute("data-title");
          const itemGenres = item.getAttribute("data-genres").split(",").map(g => g.trim());
          const itemCountry = item.getAttribute("data-country");

          const matchesQuery = !query || title.includes(query);
          const matchesGenres = selectedGenres.size === 0 || [...selectedGenres].every(g => itemGenres.includes(g));
          const matchesCountry = selectedCountries.size === 0 || selectedCountries.has(itemCountry);

          if (matchesQuery && matchesGenres && matchesCountry) {
            item.style.display = "block";
          } else {
            item.style.display = "none";
          }
        });
      }

      searchInput.addEventListener("input", filterSidebarItems);

      genresSelect.addEventListener("change", () => {
        const val = genresSelect.value;
        if (!val) return;
        let currentArr = genresInput.value.split(",").map(s => s.trim()).filter(Boolean);
        if (!currentArr.includes(val)) {
          currentArr.push(val);
          genresInput.value = currentArr.join(", ");
        }
        genresSelect.value = "";
      });

      let currentSeasons = [];

      function renderSeasons() {
        seasonsContainer.innerHTML = "";
        currentSeasons.forEach((season, index) => {
          const row = document.createElement("div");
          row.className = "season-row";
          row.innerHTML = `
            <input type="text" value="${season.title}" placeholder="Напр: 1 Сезон" data-index="${index}" class="season-title-input" style="flex: 1;" />
            <input type="text" value="${season.id}" placeholder="ID сезону (напр: lakorn_id)" data-index="${index}" class="season-id-input" style="flex: 1.5;" />
            <button type="button" class="btn-del-season" data-index="${index}">✕</button>
          `;
          seasonsContainer.appendChild(row);
        });

        document.querySelectorAll(".season-title-input").forEach((input) => {
          input.addEventListener("input", (e) => {
            currentSeasons[e.target.dataset.index].title = e.target.value.trim();
          });
        });

        document.querySelectorAll(".season-id-input").forEach((input) => {
          input.addEventListener("input", (e) => {
            currentSeasons[e.target.dataset.index].id = e.target.value.trim();
          });
        });

        document.querySelectorAll(".btn-del-season").forEach((btn) => {
          btn.addEventListener("click", (e) => {
            const idx = e.target.getAttribute("data-index");
            currentSeasons.splice(idx, 1);
            renderSeasons();
          });
        });
      }

      btnAddSeason.addEventListener("click", () => {
        const nextNum = currentSeasons.length + 1;
        currentSeasons.push({ title: `${nextNum} Сезон`, id: "" });
        renderSeasons();
      });

      let currentEpisodes = [];

      function renderEpisodes() {
        episodesContainer.innerHTML = "";
        currentEpisodes.forEach((ep, index) => {
          const row = document.createElement("div");
          row.className = "episode-row";
          row.innerHTML = `
            <span style="width: 40px; font-size: 13px;">Сер. ${ep.number}</span>
            <input type="text" value="${ep.tg_id}" placeholder="volyacore/1493" data-index="${index}" class="ep-input" />
            <button type="button" class="btn-del-ep" data-index="${index}">✕</button>
          `;
          episodesContainer.appendChild(row);
        });

        document.querySelectorAll(".ep-input").forEach((input) => {
          input.addEventListener("input", (e) => {
            const idx = e.target.getAttribute("data-index");
            currentEpisodes[idx].tg_id = e.target.value.trim();
          });
        });

        document.querySelectorAll(".btn-del-ep").forEach((btn) => {
          btn.addEventListener("click", (e) => {
            const idx = e.target.getAttribute("data-index");
            currentEpisodes.splice(idx, 1);
            currentEpisodes.forEach((item, i) => (item.number = i + 1));
            renderEpisodes();
          });
        });
      }

      btnAddEpisode.addEventListener("click", () => {
        const nextNum = currentEpisodes.length + 1;
        currentEpisodes.push({ number: nextNum, tg_id: `volyacore/` });
        renderEpisodes();
      });

      function fillForm(data) {
        document.getElementById("id").value = data.id || "";
        document.getElementById("title").value = data.title || "";
        document.getElementById("enTitle").value = data.enTitle || "";
        document.getElementById("description").value = data.description || "";
        document.getElementById("coverFile").value = "";
        document.getElementById("coverUrl").value = "";
        document.getElementById("status").value = data.status || "completed";
        document.getElementById("country").value = data.country || "thailand";
        document.getElementById("categories").value = data.categories || "BL";
        document.getElementById("year").value = data.year || 2024;
        document.getElementById("genres").value = Array.isArray(data.genres)
          ? data.genres.join(", ")
          : data.genres || "";
        document.getElementById("imdbRating").value = data.imdbRating || "";
        document.getElementById("duration").value = data.duration || "45 хв";
        document.getElementById("cast").value = Array.isArray(data.cast)
          ? data.cast.join(", ")
          : data.cast || "";
        document.getElementById("director").value = data.director || "";
        document.getElementById("network").value = data.network || "";

        currentSeasons = data.relatedSeasons ? JSON.parse(JSON.stringify(data.relatedSeasons)) : [{ title: "1 Сезон", id: data.id || "" }];
        renderSeasons();

        if (
          data.blocks &&
          data.blocks[0] &&
          Array.isArray(data.blocks[0].episodes)
        ) {
          currentEpisodes = JSON.parse(JSON.stringify(data.blocks[0].episodes));
        } else {
          currentEpisodes = [];
        }
        renderEpisodes();
      }

      btnCreateNew.addEventListener("click", () => {
        items.forEach((i) => i.classList.remove("active"));
        formTitle.textContent = "Додати новий лакорн";
        form.reset();
        currentSeasons = [];
        currentEpisodes = [];
        renderSeasons();
        renderEpisodes();
      });

      items.forEach((item) => {
        item.addEventListener("click", () => {
          items.forEach((i) => i.classList.remove("active"));
          item.classList.add("active");
          const targetId = item.getAttribute("data-id");
          const found = existingLakorns.find((l) => l.id === targetId);
          if (found) {
            formTitle.textContent = "Редагувати: " + found.title;
            fillForm(found);
          }
        });
      });

      const statusMsg = document.getElementById("status-msg");

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        statusMsg.textContent = "⏳ Збереження на GitHub...";
        statusMsg.className = "";

        const lakornId = document.getElementById("id").value.trim();
        if (!lakornId) {
          statusMsg.textContent = "Помилка: Введіть ID лакорна!";
          statusMsg.className = "error";
          return;
        }

        const formDataObj = {
          id: lakornId,
          title: document.getElementById("title").value.trim(),
          enTitle: document.getElementById("enTitle").value.trim(),
          description: document.getElementById("description").value.trim(),
          cover: `${lakornId}.jpg`,
          status: document.getElementById("status").value.trim(),
          country: document.getElementById("country").value.trim(),
          categories: document.getElementById("categories").value.trim(),
          year: Number(document.getElementById("year").value) || 2024,
          genres: document
            .getElementById("genres")
            .value.split(",")
            .map((s) => s.trim())
            .filter(Boolean),
          episodesCount: currentEpisodes.length,
          imdbRating: document.getElementById("imdbRating").value.trim(),
          duration: document.getElementById("duration").value.trim(),
          cast: document
            .getElementById("cast")
            .value.split(",")
            .map((s) => s.trim())
            .filter(Boolean),
          director: document.getElementById("director").value.trim(),
          network: document.getElementById("network").value.trim(),
          relatedSeasons: currentSeasons.length > 0 ? currentSeasons : [{ title: "1 Сезон", id: lakornId }],
          blocks: [
            {
              blockTitle: "1 Сезон",
              episodes: currentEpisodes,
            },
          ],
        };

        try {
          const GITHUB_TOKEN =
            localStorage.getItem("github_token") ||
            prompt("Введіть ваш GitHub Personal Access Token:");
          if (GITHUB_TOKEN) {
            localStorage.setItem("github_token", GITHUB_TOKEN);
          }
          const REPO_OWNER = "VolyaCore";
          const REPO_NAME = "VolyaCoreWatch";
          const FILE_PATH = "src/data/lakorns.json";
          const fileUrl = `https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/contents/${FILE_PATH}`;

          const getRes = await fetch(fileUrl, {
            headers: { Authorization: `token ${GITHUB_TOKEN}` },
          });

          if (!getRes.ok)
            throw new Error("Не вдалося підключитися до GitHub API");
          const fileJson = await getRes.json();
          const sha = fileJson.sha;

          const decodedBytes = Uint8Array.from(atob(fileJson.content), (c) =>
            c.charCodeAt(0)
          );
          let lakornsList = JSON.parse(new TextDecoder().decode(decodedBytes));

          if (!Array.isArray(lakornsList)) lakornsList = [];

          const index = lakornsList.findIndex((item) => item.id === lakornId);
          if (index >= 0) {
            lakornsList[index] = formDataObj;
          } else {
            lakornsList.push(formDataObj);
          }

          const encodedContent = btoa(
            unescape(encodeURIComponent(JSON.stringify(lakornsList, null, 2)))
          );

          const putRes = await fetch(fileUrl, {
            method: "PUT",
            headers: {
              Authorization: `token ${GITHUB_TOKEN}`,
              "Content-Type": "application/json",
            },
            body: JSON.stringify({
              message: `Admin: update lakorn -> ${formDataObj.title}`,
              content: encodedContent,
              sha: sha,
            }),
          });

          if (!putRes.ok) {
            const errJson = await putRes.json().catch(() => ({}));
            throw new Error(errJson.message || "Помилка збереження на GitHub");
          }

          statusMsg.textContent = "✅ Успішно! Зміни збережено на GitHub.";
          statusMsg.className = "success";
          setTimeout(() => location.reload(), 2000);
        } catch (err) {
          statusMsg.textContent = "Помилка: " + err.message;
          statusMsg.className = "error";
        }
      });
    </script>
  </body>
</html>