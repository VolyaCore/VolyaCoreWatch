      //       JSON.stringify(data.blocks[1].episodes)
      //     );
      //   }

      //   renderSpecialEpisodes();

      //   btnCreateNew.addEventListener("click", () => {
      //     items.forEach((i) => i.classList.remove("active"));

      //     formTitle.textContent = "Додати новий лакорн";

      //     form.reset();

      //     currentEpisodes = [];
      //     renderEpisodes();

      //     currentSpecialEpisodes = [];
      //     renderSpecialEpisodes();

      //     currentSeasons = [];
      //     renderSeasons();
      //   });

      //   items.forEach((item) => {
      //     item.addEventListener("click", () => {
      //       items.forEach((i) => i.classList.remove("active"));
      //       item.classList.add("active");
      //       const targetId = item.getAttribute("data-id");
      //       const found = existingLakorns.find((l) => l.id === targetId);
      //       if (found) {
      //         formTitle.textContent = "Редагувати: " + found.title;
      //         fillForm(found);
      //       }
      //     });
      //   });

      const items = document.querySelectorAll(".lakorn-item");
      const btnCreateNew = document.getElementById("btn-create-new");
      const formTitle = document.getElementById("form-title");
      const form = document.getElementById("lakorn-form");

      const seasonsContainer = document.getElementById("seasons-container");
      const btnAddSeason = document.getElementById("btn-add-season");

      const episodesContainer = document.getElementById("episodes-container");
      const btnAddEpisode = document.getElementById("btn-add-episode");

      const specialEpisodesContainer = document.getElementById(
        "special-episodes-container"
      );
      const btnAddSpecialEpisode = document.getElementById(
        "btn-add-special-episode"
      );

      const searchInput = document.getElementById("project-search-input");
      const genresSelect = document.getElementById("genres-select");
      const genresInput = document.getElementById("genres");

      let selectedGenres = new Set();
      let selectedCountries = new Set();

      let currentSeasons = [];
      let currentEpisodes = [];
      let currentSpecialEpisodes = [];

      // =====================================================
      // ПОШУК ПРОЄКТІВ
      // =====================================================

      function filterSidebarItems() {
        const query = searchInput.value.toLowerCase().trim();

        items.forEach((item) => {
          const title = (item.getAttribute("data-title") || "").toLowerCase();

          const itemGenres = (item.getAttribute("data-genres") || "")
            .split(",")
            .map((g) => g.trim())
            .filter(Boolean);

          const itemCountry = item.getAttribute("data-country") || "";

          const matchesQuery = !query || title.includes(query);

          const matchesGenres =
            selectedGenres.size === 0 ||
            [...selectedGenres].every((g) => itemGenres.includes(g));

          const matchesCountry =
            selectedCountries.size === 0 || selectedCountries.has(itemCountry);

          item.style.display =
            matchesQuery && matchesGenres && matchesCountry ? "block" : "none";
        });
      }

      searchInput.addEventListener("input", filterSidebarItems);

      // =====================================================
      // ЖАНРИ
      // =====================================================

      genresSelect.addEventListener("change", () => {
        const val = genresSelect.value;

        if (!val) return;

        let currentArr = genresInput.value
          .split(",")
          .map((s) => s.trim())
          .filter(Boolean);

        if (!currentArr.includes(val)) {
          currentArr.push(val);
          genresInput.value = currentArr.join(", ");
        }

        genresSelect.value = "";
      });

      // =====================================================
      // ЗВИЧАЙНІ СЕРІЇ
      // =====================================================

      function renderEpisodes() {
        episodesContainer.innerHTML = "";

        currentEpisodes.forEach((ep, index) => {
          const row = document.createElement("div");

          row.className = "season-row";

          row.innerHTML = `
      <span style="
        color: #94a3b8;
        font-size: 13px;
        font-weight: bold;
        width: 30px;
        text-align: center;
      ">
        #${index + 1}
      </span>

      <input
        type="text"
        value="${ep.tg_id || ""}"
        placeholder="volyacore/..."
        data-index="${index}"
        class="episode-input"
        style="flex: 1;"
      />

      <button
        type="button"
        class="btn-del-season btn-del-episode"
        data-index="${index}"
      >
        ✕
      </button>
    `;

          episodesContainer.appendChild(row);
        });

        document.querySelectorAll(".episode-input").forEach((input) => {
          input.addEventListener("input", (e) => {
            const index = Number(e.target.dataset.index);

            if (currentEpisodes[index]) {
              currentEpisodes[index].tg_id = e.target.value.trim();
            }
          });
        });

        document.querySelectorAll(".btn-del-episode").forEach((button) => {
          button.addEventListener("click", (e) => {
            const index = Number(e.target.dataset.index);

            currentEpisodes.splice(index, 1);

            currentEpisodes.forEach((ep, i) => {
              ep.number = i + 1;
            });

            renderEpisodes();
          });
        });
      }

      btnAddEpisode.addEventListener("click", () => {
        currentEpisodes.push({
          number: currentEpisodes.length + 1,
          tg_id: "",
        });

        renderEpisodes();
      });

      // =====================================================
      // СПЕЦВИПУСКИ
      // =====================================================

      function renderSpecialEpisodes() {
        specialEpisodesContainer.innerHTML = "";

        currentSpecialEpisodes.forEach((ep, index) => {
          const row = document.createElement("div");

          row.className = "season-row";

          row.innerHTML = `
      <span style="
        color: #94a3b8;
        font-size: 13px;
        font-weight: bold;
        width: 30px;
        text-align: center;
      ">
        #${index + 1}
      </span>

      <input
        type="text"
        value="${ep.tg_id || ""}"
        placeholder="volyacore/..."
        data-index="${index}"
        class="special-episode-input"
        style="flex: 1;"
      />

      <button
        type="button"
        class="btn-del-season btn-del-special-episode"
        data-index="${index}"
      >
        ✕
      </button>
    `;

          specialEpisodesContainer.appendChild(row);
        });

        document.querySelectorAll(".special-episode-input").forEach((input) => {
          input.addEventListener("input", (e) => {
            const index = Number(e.target.dataset.index);

            if (currentSpecialEpisodes[index]) {
              currentSpecialEpisodes[index].tg_id = e.target.value.trim();
            }
          });
        });

        document
          .querySelectorAll(".btn-del-special-episode")
          .forEach((button) => {
            button.addEventListener("click", (e) => {
              const index = Number(e.target.dataset.index);

              currentSpecialEpisodes.splice(index, 1);

              currentSpecialEpisodes.forEach((ep, i) => {
                ep.number = i + 1;
              });

              renderSpecialEpisodes();
            });
          });
      }

      btnAddSpecialEpisode.addEventListener("click", () => {
        currentSpecialEpisodes.push({
          number: currentSpecialEpisodes.length + 1,
          tg_id: "",
        });

        renderSpecialEpisodes();
      });

      // =====================================================
      // ПОВ'ЯЗАНІ СЕЗОНИ
      // ЦЮ СИСТЕМУ НЕ ЗМІНЮЄМО
      // =====================================================

      function renderSeasons() {
        seasonsContainer.innerHTML = "";

        currentSeasons.forEach((season, index) => {
          const row = document.createElement("div");

          row.className = "season-row";

          row.innerHTML = `
      <input
        type="text"
        value="${season.title || ""}"
        placeholder="Напр: 1 Сезон"
        data-index="${index}"
        class="season-title-input"
        style="flex: 1;"
      />

      <input
        type="text"
        value="${season.id || ""}"
        placeholder="ID сезону (напр: lakorn_id)"
        data-index="${index}"
        class="season-id-input"
        style="flex: 1.5;"
      />

      <button
        type="button"
        class="btn-del-season"
        data-index="${index}"
      >
        ✕
      </button>
    `;

          seasonsContainer.appendChild(row);
        });

        document.querySelectorAll(".season-title-input").forEach((input) => {
          input.addEventListener("input", (e) => {
            const index = Number(e.target.dataset.index);

            if (currentSeasons[index]) {
              currentSeasons[index].title = e.target.value.trim();
            }
          });
        });

        document.querySelectorAll(".season-id-input").forEach((input) => {
          input.addEventListener("input", (e) => {
            const index = Number(e.target.dataset.index);

            if (currentSeasons[index]) {
              currentSeasons[index].id = e.target.value.trim();
            }
          });
        });

        document.querySelectorAll(".btn-del-season").forEach((button) => {
          button.addEventListener("click", (e) => {
            const index = Number(e.target.dataset.index);

            currentSeasons.splice(index, 1);

            renderSeasons();
          });
        });
      }

      btnAddSeason.addEventListener("click", () => {
        const nextNum = currentSeasons.length + 1;

        currentSeasons.push({
          title: `${nextNum} Сезон`,
          id: "",
        });

        renderSeasons();
      });

      // =====================================================
      // ЗАПОВНЕННЯ ФОРМИ ІСНУЮЧИМ ПРОЄКТОМ
      // =====================================================

      function fillForm(data) {
        document.getElementById("id").value = data.id || "";

        document.getElementById("title").value = data.title || "";

        document.getElementById("enTitle").value = data.enTitle || "";

        document.getElementById("description").value = data.description || "";

        document.getElementById("currentCover").value = data.cover || "";

        document.getElementById("coverFile").value = "";

        document.getElementById("coverUrl").value = "";

        document.getElementById("status").value = data.status || "completed";

        document.getElementById("country").value = data.country || "thailand";

        document.getElementById("categories").value = data.categories || "BL";

        document.getElementById("year").value = data.year || 2024;

        document.getElementById("genres").value = Array.isArray(data.genres)
          ? data.genres.join(", ")
          : data.genres || "";

        document.getElementById("imdbRating").value = data.imdbRating || "";

        document.getElementById("duration").value = data.duration || "";

        document.getElementById("cast").value = Array.isArray(data.cast)
          ? data.cast.join(", ")
          : data.cast || "";

        document.getElementById("director").value = data.director || "";

        document.getElementById("network").value = data.network || "";

        document.getElementById("episodesCount").value =
          data.episodesCount !== undefined ? data.episodesCount : "";

        // ===================================================
        // ЗВИЧАЙНІ СЕРІЇ
        // ===================================================

        currentEpisodes = [];

        if (
          Array.isArray(data.blocks) &&
          data.blocks.length > 0 &&
          Array.isArray(data.blocks[0].episodes)
        ) {
          currentEpisodes = JSON.parse(JSON.stringify(data.blocks[0].episodes));
        }

        renderEpisodes();

        // ===================================================
        // СПЕЦВИПУСКИ
        // ===================================================

        currentSpecialEpisodes = [];

        if (Array.isArray(data.blocks) && data.blocks.length > 1) {
          const specialBlock = data.blocks.find(
            (block) => block && block.blockTitle === "Спецвипуск"
          );

          if (specialBlock && Array.isArray(specialBlock.episodes)) {
            currentSpecialEpisodes = JSON.parse(
              JSON.stringify(specialBlock.episodes)
            );
          }
        }

        renderSpecialEpisodes();

        // ===================================================
        // ПОВ'ЯЗАНІ СЕЗОНИ
        // ===================================================

        if (Array.isArray(data.relatedSeasons)) {
          currentSeasons = JSON.parse(JSON.stringify(data.relatedSeasons));
        } else {
          currentSeasons = [
            {
              title: "1 Сезон",
              id: data.id || "",
            },
          ];
        }

        renderSeasons();
      }

      // =====================================================
      // НОВИЙ ЛАКОРН
      // =====================================================

      btnCreateNew.addEventListener("click", () => {
        items.forEach((item) => {
          item.classList.remove("active");
        });

        formTitle.textContent = "Додати новий лакорн";

        form.reset();

        // Звичайні серії
        currentEpisodes = [];

        renderEpisodes();

        // Спецвипуски
        currentSpecialEpisodes = [];

        renderSpecialEpisodes();

        // Пов'язані сезони
        currentSeasons = [];

        renderSeasons();

        // Значення за замовчуванням
        document.getElementById("status").value = "completed";

        document.getElementById("country").value = "thailand";

        document.getElementById("categories").value = "BL";

        document.getElementById("year").value = 2024;

        document.getElementById("genres").value = "romance, comedy";
      });

      // =====================================================
      // ВІДКРИТТЯ ГОТОВОГО ПРОЄКТУ
      // =====================================================

      items.forEach((item) => {
        item.addEventListener("click", () => {
          // Прибираємо active з усіх
          items.forEach((i) => {
            i.classList.remove("active");
          });

          // Робимо вибраний активним
          item.classList.add("active");

          const targetId = item.getAttribute("data-id");

          if (!targetId) {
            console.error("Не знайдено data-id у проєкту");
            return;
          }

          const found = existingLakorns.find(
            (lakorn) => String(lakorn.id) === String(targetId)
          );

          if (!found) {
            console.error("Проєкт не знайдено:", targetId);
            return;
          }

          formTitle.textContent = "Редагувати: " + found.title;

          fillForm(found);

          // Прокручуємо форму наверх
          document.querySelector("main").scrollTop = 0;
        });
      });

      const statusMsg = document.getElementById("status-msg");

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        statusMsg.textContent = "⏳ Збереження на GitHub...";
        statusMsg.className = "";

        const lakornId = document.getElementById("id").value.trim();
        if (!lakornId) {
          statusMsg.textContent = "Помилка: Введіть ID лакорна!";
          statusMsg.className = "error";
          return;
        }

        // Автоматично оновлюємо номери серій перед збереженням
        currentEpisodes.forEach((ep, index) => {
          ep.number = index + 1;
        });

        currentSpecialEpisodes.forEach((ep, index) => {
          ep.number = index + 1;
        });

        try {
          const GITHUB_TOKEN =
            localStorage.getItem("github_token") ||
            prompt("Введіть ваш GitHub Personal Access Token:");
          if (GITHUB_TOKEN) {
            localStorage.setItem("github_token", GITHUB_TOKEN);
          }
          const REPO_OWNER = "VolyaCore";
          const REPO_NAME = "VolyaCoreWatch";

          // 1. Обробка обкладинки (файл або посилання)
          const coverFileinput = document.getElementById("coverFile");
          const coverUrlInput = document
            .getElementById("coverUrl")
            .value.trim();
          let coverFileName = `${lakornId}.jpg`;

          if (coverFileinput.files && coverFileinput.files[0]) {
            const file = coverFileinput.files[0];
            const fileExt = file.name.split(".").pop();
            coverFileName = `${lakornId}.${fileExt}`;

            // Читаємо файл у Base64 для GitHub API
            const base64Content = await new Promise((resolve, reject) => {
              const reader = new FileReader();
              reader.onload = () => resolve(reader.result.split(",")[1]);
              reader.onerror = (error) => reject(error);
              reader.readAsDataURL(file);
            });

            const coverPath = `src/assets/covers/${coverFileName}`;
            const coverApiUrl = `https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/contents/${coverPath}`;

            // Перевіряємо чи існує вже файл обкладинки (щоб взяти його SHA для перезаписування)
            let coverSha = undefined;
            const existingCoverRes = await fetch(coverApiUrl, {
              headers: { Authorization: `token ${GITHUB_TOKEN}` },
            });
            if (existingCoverRes.ok) {
              const coverDataJson = await existingCoverRes.json();
              coverSha = coverDataJson.sha;
            }

            // Завантажуємо файл обкладинки в папку src/assets/covers/
            const coverPutRes = await fetch(coverApiUrl, {
              method: "PUT",
              headers: {
                Authorization: `token ${GITHUB_TOKEN}`,
                "Content-Type": "application/json",
              },
              body: JSON.stringify({
                message: `Admin: upload cover for ${lakornId}`,
                content: base64Content,
                sha: coverSha,
              }),
            });

            if (!coverPutRes.ok) {
              throw new Error(
                "Не вдалося завантажити файл обкладинки на GitHub"
              );
            }
          } else if (coverUrlInput) {
            coverFileName = coverUrlInput; // Якщо вказано пряме посилання
          }

          const formDataObj = {
            id: lakornId,
            title: document.getElementById("title").value.trim(),
            enTitle: document.getElementById("enTitle").value.trim(),
            description: document.getElementById("description").value.trim(),
            cover: coverFileName,
            status: document.getElementById("status").value.trim(),
            country: document.getElementById("country").value.trim(),
            categories: document.getElementById("categories").value.trim(),
            year: Number(document.getElementById("year").value) || 2024,
            genres: document
              .getElementById("genres")
              .value.split(",")
              .map((s) => s.trim())
              .filter(Boolean),
            imdbRating: document.getElementById("imdbRating").value.trim(),
            duration: document.getElementById("duration").value.trim(),
            cast: document
              .getElementById("cast")
              .value.split(",")
              .map((s) => s.trim())
              .filter(Boolean),
            director: document.getElementById("director").value.trim(),
            network: document.getElementById("network").value.trim(),
            episodesCount:
              Number(document.getElementById("episodesCount").value) || 0,
            relatedSeasons:
              currentSeasons.length > 0
                ? currentSeasons
                : [{ title: "1 Сезон", id: lakornId }],
            blocks: [
              {
                blockTitle: "1 Сезон",
                episodes: currentEpisodes,
              },

              ...(currentSpecialEpisodes.length > 0
                ? [
                    {
                      blockTitle: "Спецвипуск",
                      episodes: currentSpecialEpisodes,
                    },
                  ]
                : []),
            ],
          };

          // 2. Оновлення файлу lakorns.json
          const FILE_PATH = "src/data/lakorns.json";
          const fileUrl = `https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/contents/${FILE_PATH}`;

          const getRes = await fetch(fileUrl, {
            headers: { Authorization: `token ${GITHUB_TOKEN}` },
          });

          if (!getRes.ok)
            throw new Error("Не вдалося підключитися до GitHub API для JSON");
          const fileJson = await getRes.json();
          const sha = fileJson.sha;

          const decodedBytes = Uint8Array.from(atob(fileJson.content), (c) =>
            c.charCodeAt(0)
          );
          let lakornsList = JSON.parse(new TextDecoder().decode(decodedBytes));

          if (!Array.isArray(lakornsList)) lakornsList = [];

          const index = lakornsList.findIndex((item) => item.id === lakornId);
          if (index >= 0) {
            lakornsList[index] = formDataObj;
          } else {
            lakornsList.push(formDataObj);
          }

          const encodedContent = btoa(
            unescape(encodeURIComponent(JSON.stringify(lakornsList, null, 2)))
          );

          const putRes = await fetch(fileUrl, {
            method: "PUT",
            headers: {
              Authorization: `token ${GITHUB_TOKEN}`,
              "Content-Type": "application/json",
            },
            body: JSON.stringify({
              message: `Admin: update lakorn -> ${formDataObj.title}`,
              content: encodedContent,
              sha: sha,
            }),
          });

          if (!putRes.ok) {
            const errJson = await putRes.json().catch(() => ({}));
            throw new Error(
              errJson.message || "Помилка збереження JSON на GitHub"
            );
          }

          statusMsg.textContent =
            "✅ Успішно! Зміни та обкладинку збережено на GitHub.";
          statusMsg.className = "success";
          setTimeout(() => location.reload(), 2000);
        } catch (err) {
          statusMsg.textContent = "Помилка: " + err.message;
          statusMsg.className = "error";
        }
      });
    </script>
  </body>
</html>
