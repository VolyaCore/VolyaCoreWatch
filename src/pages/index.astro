---
import MainLayout from "../layouts/MainLayout.astro";
import MovieCard from "../components/MovieCard.astro";
import lakornsData from "../data/lakorns.json";

const latestLakorns = lakornsData.slice(0, 24);
---

<MainLayout title="VolyaCore">
  <section class="hero-carousel-section">
    <div class="carousel-container">
      <div class="carousel-track" id="carousel-track">
        {
          lakornsData
            .filter((lakorn) => lakorn.status.toLowerCase() === "ongoing")
            .map((lakorn) => (
              <div
                class="carousel-slide-wrapper carousel-active"
                data-id={lakorn.id}
              >
                <MovieCard
                  id={lakorn.id}
                  title={lakorn.title}
                  enTitle={lakorn.enTitle}
                  cover={lakorn.cover}
                  status={lakorn.status}
                  episodesCount={lakorn.episodesCount}
                  country={lakorn.country}
                  year={lakorn.year}
                  genres={lakorn.genres}
                  imdbRating={lakorn.imdbRating}
                />
              </div>
            ))
        }
      </div>

      <button
        class="carousel-nav-btn prev-btn"
        id="carousel-prev"
        aria-label="Попередній">❮</button
      >
      <button
        class="carousel-nav-btn next-btn"
        id="carousel-next"
        aria-label="Наступний">❯</button
      >

      <div class="carousel-dots" id="carousel-dots"></div>
    </div>
  </section>

  <section class="filters-section">
    <div class="filter-group">
      <label for="filter-country">Країна</label>
      <select id="filter-country" class="filter-group">
        <option value="all">Усі країни</option>
        <option value="thailand">Таїланд</option>
        <option value="korea">Південна Корея</option>
        <option value="japan">Японія</option>
        <option value="china">Китай</option>
        <option value="taiwan">Тайвань</option>
        <option value="singapore">Сінгапур</option>
        <option value="philippines">Філіппіни</option>
      </select>
    </div>

    <div class="filter-group">
      <label for="filter-genre">Жанр</label>
      <select id="filter-genre" class="filter-group">
        <option value="all">Усі жанри</option>
        <option value="romance">Романтика</option>
        <option value="drama">Драма</option>
        <option value="comedy">Комедія</option>
        <option value="crime">Кримінал</option>
        <option value="sports">Спорт</option>
        <option value="music">Музика</option>
        <option value="routine">Буденність</option>
        <option value="fantasy">Фентезі</option>
        <option value="fantastic">Фантастика</option>
        <option value="action">Бойовик</option>
        <option value="horrors">Жахи</option>
        <option value="supernatural">Надприродне</option>
        <option value="thriller">Триллер</option>
        <option value="mysticism">Містика</option>
        <option value="youth">Юність</option>
        <option value="law">Закон</option>
        <option value="melodrama">Мелодрама</option>
        <option value="business">Бізнес</option>
        <option value="food">Страви</option>
        <option value="medical">Медицина</option>
        <option value="historical">Історичне</option>
        <option value="psychological">Психологія</option>
        <option value="life">Життя</option>
        <option value="slice of life">Повседневність</option>
        <option value="fashion film">Фешн-фільм</option>
        <option value="adult">Для дорослих</option>
        <option value="sci-fi">Наукова Фантастика</option>
      </select>
    </div>

    <div class="filter-group">
      <label for="filter-format">Формат</label>
      <select id="filter-format" class="filter-group">
        <option value="all">Усі</option>
        <option value="film">Фільми</option>
        <option value="series">Серіали</option>
      </select>
    </div>

    <!-- <div class="filter-group">
      <label for="filter-year">Рік</label>
      <select id="filter-year" class="filter-group">
        <option value="all">Усі роки</option>
        <option value="2026">2026</option>
        <option value="2025">2025</option>
        <option value="2024">2024</option>
        <option value="2023">2023</option>
        <option value="2022">2022</option>
        <option value="2021">2021</option>
        <option value="2020">2020</option>
        <option value="2019">2019</option>
        <option value="2018">2018</option>
        <option value="2017">2017</option>
        <option value="2016">2016</option>
        <option value="2015">2015</option>
        <option value="2009">2009</option>
        <option value="2003">2003</option>
        <option value="2001">2001</option>
      </select>
    </div> -->

    <div class="filter-group">
      <label for="filter-sort">Сортування</label>
      <select id="filter-sort" class="filter-group">
        <option value="default">За замовчуванням</option>
        <option value="status-ongoing">В процесі спочатку</option>
        <option value="status-completed">Завершені спочатку</option>
        <option value="rating-desc">Рейтинг від найбільшого</option>
        <option value="rating-asc">Рейтинг від найменшого</option>
      </select>
    </div>

    <div class="filter-group">
      <label for="filter-category">Категорія</label>
      <select id="filter-category" class="filter-group">
        <option value="all">Усі категорії</option>
        <option value="Bl">BL</option>
        <option value="Gl">GL</option>
        <option value="Інше">Інше</option>
      </select>
    </div>

    <div class="filter-group" id="studio-filter-wrapper" style="display: none;">
      <label for="filter-studio">Тайські студії</label>
      <select id="filter-studio" class="filter-group">
        <option value="all">Усі студії</option>
        <option value="Me Mind Y">Me Mind Y</option>
        <option value="Be On Cloud">Be On Cloud</option>
        <option value="CHANGE2561">CHANGE2561</option>
        <option value="Domundi TV">Domundi TV</option>
        <option value="GMMTV">GMMTV</option>
        <option value="other">Інші</option>
      </select>
    </div>
  </section>

  <section class="catalog-section">
    <h2>Усі релізи</h2>

    <div class="movies-grid catalog-fixed-grid" id="catalog-grid">
      {
        latestLakorns.map((lakorn) => (
          <div
            class="catalog-card-wrapper"
            data-id={lakorn.id}
            data-title={lakorn.title.toLowerCase()}
            data-en-title={lakorn.enTitle ? lakorn.enTitle.toLowerCase() : ""}
            data-status={lakorn.status.toLowerCase()}
            data-country={lakorn.country}
            data-category={lakorn.categories ? lakorn.categories : ""}
            data-year={lakorn.year}
            data-genres={lakorn.genres.join(",")}
            data-rating={lakorn.imdbRating ?? ""}
            data-network={(lakorn.network || "").toLowerCase()}
          >
            <MovieCard
              id={lakorn.id}
              title={lakorn.title}
              enTitle={lakorn.enTitle}
              cover={lakorn.cover}
              status={lakorn.status}
              episodesCount={lakorn.episodesCount}
              country={lakorn.country}
              year={lakorn.year}
              genres={lakorn.genres}
              imdbRating={lakorn.imdbRating}
            />
          </div>
        ))
      }
    </div>

    <div class="pagination-container" id="pagination-controls"></div>

    <div id="hidden-full-database" style="display: none;">
      {
        lakornsData.map((lakorn) => (
          <div
            class="database-card-source"
            data-id={lakorn.id}
            data-title={lakorn.title.toLowerCase()}
            data-en-title={lakorn.enTitle ? lakorn.enTitle.toLowerCase() : ""}
            data-status={lakorn.status.toLowerCase()}
            data-country={lakorn.country}
            data-category={lakorn.categories ? lakorn.categories : ""}
            data-year={lakorn.year}
            data-genres={lakorn.genres.join(",")}
            data-rating={lakorn.imdbRating ?? ""}
            data-network={(lakorn.network || "").toLowerCase()}
          >
            <MovieCard
              id={lakorn.id}
              title={lakorn.title}
              enTitle={lakorn.enTitle}
              cover={lakorn.cover}
              status={lakorn.status}
              episodesCount={lakorn.episodesCount}
              country={lakorn.country}
              year={lakorn.year}
              genres={lakorn.genres}
              imdbRating={lakorn.imdbRating}
            />
          </div>
        ))
      }
    </div>

    <div id="no-results" class="no-results-msg" style="display: none;">
      <p>🔍 На жаль, нічого не знайдено за такими критеріями фільтрації.</p>
    </div>
  </section>

  <script>
    // Глобальні змінні
    let searchInput: HTMLInputElement | null = null;
    let allSourceCards: Element[] = [];
    let currentFilteredCards: Element[] = [];
    let currentPage = 1;
    const ITEMS_PER_PAGE = 24;

    // --- ЛОГІКА КАРУСЕЛІ ---
    function initCarousel() {
      const track = document.getElementById("carousel-track") as HTMLElement;
      const nextBtn = document.getElementById("carousel-next");
      const prevBtn = document.getElementById("carousel-prev");

      if (!track) return;

      let currentIndex = 0;

      nextBtn?.addEventListener("click", () => {
        const slideWidth =
          track.querySelector(".carousel-slide-wrapper")?.clientWidth || 0;
        const gap = 20; // має збігатися з gap у CSS
        const maxIndex =
          track.children.length -
          Math.floor(track.parentElement!.clientWidth / slideWidth);

        if (currentIndex < maxIndex) {
          currentIndex++;
          track.style.transform = `translateX(-${currentIndex * (slideWidth + gap)}px)`;
        }
      });

      prevBtn?.addEventListener("click", () => {
        const slideWidth =
          track.querySelector(".carousel-slide-wrapper")?.clientWidth || 0;
        const gap = 20;

        if (currentIndex > 0) {
          currentIndex--;
          track.style.transform = `translateX(-${currentIndex * (slideWidth + gap)}px)`;
        }
      });
    }

    // --- ЛОГІКА КАТАЛОГУ ---
    function applyImageFix(container: HTMLElement) {
      container.querySelectorAll("img").forEach((img) => {
        img.style.setProperty("width", "100%", "important");
        img.style.setProperty("height", "auto", "important");
        img.style.setProperty("aspect-ratio", "2 / 3", "important");
        img.style.setProperty("object-fit", "cover", "important");
        img.style.setProperty("display", "block", "important");
      });
    }

    function displayCurrentPage() {
      const catalogGrid = document.getElementById("catalog-grid");
      if (!catalogGrid) return;
      catalogGrid.innerHTML = "";
      const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
      const pageCards = currentFilteredCards.slice(
        startIndex,
        startIndex + ITEMS_PER_PAGE
      );

      pageCards.forEach((sourceCard) => {
        const clonedCard = sourceCard.cloneNode(true) as HTMLElement;
        clonedCard.className = "catalog-card-wrapper";
        catalogGrid.appendChild(clonedCard);
      });
      applyImageFix(catalogGrid);
    }

    function filterCatalog() {
      const query =
        (document.querySelector("#global-search") as HTMLInputElement)?.value
          .toLowerCase()
          .trim() || "";
      const country =
        (document.getElementById("filter-country") as HTMLSelectElement)
          ?.value || "all";
      const genre =
        (document.getElementById("filter-genre") as HTMLSelectElement)?.value ||
        "all";
      const year =
        (document.getElementById("filter-year") as HTMLSelectElement)?.value ||
        "all";
      const sort =
        (document.getElementById("filter-sort") as HTMLSelectElement)?.value ||
        "default";
      const category =
        (document.getElementById("filter-category") as HTMLSelectElement)
          ?.value || "all";

      const filtered = allSourceCards.filter((card) => {
        const genres = (card.getAttribute("data-genres") || "").split(",");
        return (
          (query === "" || card.getAttribute("data-title")!.includes(query)) &&
          (country === "all" ||
            card.getAttribute("data-country") === country) &&
          (year === "all" || card.getAttribute("data-year") === year) &&
          (genre === "all" || genres.includes(genre)) &&
          (category === "all" ||
            card.getAttribute("data-category") === category)
        );
      });

      // Сортування (спрощене)
      currentFilteredCards = filtered.sort(() => 0.5 - Math.random());
      currentPage = 1;
      displayCurrentPage();
    }

    function initPageFeatures() {
      const dbSourceContainer = document.getElementById("hidden-full-database");
      if (!dbSourceContainer) return;

      allSourceCards = Array.from(
        dbSourceContainer.querySelectorAll(".database-card-source")
      );

      // Ініціалізація слухачів
      document
        .querySelectorAll("select")
        .forEach((el) => el.addEventListener("change", filterCatalog));

      initCarousel();
      filterCatalog();
    }

    document.addEventListener("DOMContentLoaded", initPageFeatures);
    document.addEventListener("astro:after-swap", initPageFeatures);
  </script>

  <script>
    // 1. Глобальні змінні
    let searchInput: HTMLInputElement | null = null;
    let allSourceCards: Element[] = [];
    let currentFilteredCards: Element[] = [];
    let currentPage = 1;
    const ITEMS_PER_PAGE = 24;

    // 2. Функції відображення
    function applyImageFix(container: HTMLElement) {
      container.querySelectorAll("img").forEach((img) => {
        img.style.setProperty("width", "100%", "important");
        img.style.setProperty("height", "auto", "important");
        img.style.setProperty("aspect-ratio", "2 / 3", "important");
        img.style.setProperty("object-fit", "cover", "important");
        img.style.setProperty("display", "block", "important");
      });
    }

    function displayCurrentPage() {
      const catalogGrid = document.getElementById("catalog-grid");
      if (!catalogGrid) return;
      catalogGrid.innerHTML = "";

      const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
      const pageCards = currentFilteredCards.slice(
        startIndex,
        startIndex + ITEMS_PER_PAGE
      );

      pageCards.forEach((sourceCard) => {
        const clonedCard = sourceCard.cloneNode(true) as HTMLElement;
        clonedCard.className = "catalog-card-wrapper";
        catalogGrid.appendChild(clonedCard);
      });
      applyImageFix(catalogGrid);
    }

    // 3. Логіка сортування та фільтрації
    function applySorting(cards: Element[], sortValue: string): Element[] {
      const sorted = [...cards];
      switch (sortValue) {
        case "status-ongoing":
          return sorted.sort(
            (a, b) =>
              (a.getAttribute("data-status") === "ongoing" ? 0 : 1) -
              (b.getAttribute("data-status") === "ongoing" ? 0 : 1)
          );
        case "status-completed":
          return sorted.sort(
            (a, b) =>
              (a.getAttribute("data-status") !== "ongoing" ? 0 : 1) -
              (b.getAttribute("data-status") !== "ongoing" ? 0 : 1)
          );
        case "rating-desc":
          return sorted
            .filter((c) => c.getAttribute("data-status") !== "ongoing")
            .sort(
              (a, b) =>
                parseFloat(b.getAttribute("data-rating") || "0") -
                parseFloat(a.getAttribute("data-rating") || "0")
            );
        default:
          return sorted.sort(() => 0.5 - Math.random());
      }
    }

    function filterCatalog() {
      const query = searchInput ? searchInput.value.toLowerCase().trim() : "";
      const country =
        (document.getElementById("filter-country") as HTMLSelectElement)
          ?.value || "all";
      const genre =
        (document.getElementById("filter-genre") as HTMLSelectElement)?.value ||
        "all";
      const year =
        (document.getElementById("filter-year") as HTMLSelectElement)?.value ||
        "all";
      const sort =
        (document.getElementById("filter-sort") as HTMLSelectElement)?.value ||
        "default";
      const category =
        (document.getElementById("filter-category") as HTMLSelectElement)
          ?.value || "all";

      const filtered = allSourceCards.filter((card) => {
        const titleUa = card.getAttribute("data-title") || "";
        const titleEn = card.getAttribute("data-en-title") || "";
        const genres = (card.getAttribute("data-genres") || "").split(",");

        return (
          (query === "" ||
            titleUa.includes(query) ||
            titleEn.includes(query)) &&
          (country === "all" ||
            card.getAttribute("data-country") === country) &&
          (year === "all" || card.getAttribute("data-year") === year) &&
          (genre === "all" || genres.includes(genre)) &&
          (category === "all" ||
            card.getAttribute("data-category") === category)
        );
      });

      currentFilteredCards = applySorting(filtered, sort);
      currentPage = 1;
      displayCurrentPage();
      // (тут ви можете додати виклик renderPagination, якщо він у вас є)
      const noResults = document.getElementById("no-results");
      if (noResults)
        noResults.style.display =
          currentFilteredCards.length === 0 ? "block" : "none";
    }

    // 4. Ініціалізація
    function initPageFeatures() {
      const dbSourceContainer = document.getElementById("hidden-full-database");
      if (!dbSourceContainer) return;

      searchInput = document.querySelector(
        'input[type="text"], #global-search'
      ) as HTMLInputElement;
      allSourceCards = Array.from(
        dbSourceContainer.querySelectorAll(".database-card-source")
      );

      // Події
      searchInput?.addEventListener("input", filterCatalog);
      document
        .getElementById("filter-country")
        ?.addEventListener("change", filterCatalog);
      document
        .getElementById("filter-genre")
        ?.addEventListener("change", filterCatalog);
      document
        .getElementById("filter-year")
        ?.addEventListener("change", filterCatalog);
      document
        .getElementById("filter-sort")
        ?.addEventListener("change", filterCatalog);
      document
        .getElementById("filter-category")
        ?.addEventListener("change", filterCatalog);

      // Перевірка URL на наявність пошуку
      const params = new URLSearchParams(window.location.search);
      const q = params.get("search");
      if (q && searchInput) {
        searchInput.value = q;
        window.history.replaceState(
          {},
          document.title,
          window.location.pathname
        );
      }

      filterCatalog();
    }

    // 5. Запуск
    document.addEventListener("DOMContentLoaded", initPageFeatures);
    document.addEventListener("astro:after-swap", initPageFeatures);

    // Слухач для оновлення пошуку з Хедеру (якщо ви вже на сторінці)
    document.addEventListener("search-trigger", ((e: CustomEvent) => {
      if (searchInput) {
        searchInput.value = e.detail;
        filterCatalog();
      }
    }) as EventListener);
  </script>

  <script>
    function initPageFeatures() {
      const catalogGrid = document.getElementById("catalog-grid");
      const dbSourceContainer = document.getElementById("hidden-full-database");
      const paginationControls = document.getElementById("pagination-controls");

      if (!catalogGrid || !dbSourceContainer) return;

      const ITEMS_PER_PAGE = 24;
      let currentPage = 1;
      let currentFilteredCards: Element[] = [];

      function applyImageFix(container: HTMLElement) {
        const images = container.querySelectorAll("img");
        images.forEach((img) => {
          img.style.setProperty("width", "100%", "important");
          img.style.setProperty("height", "auto", "important");
          img.style.setProperty("aspect-ratio", "2 / 3", "important");
          img.style.setProperty("object-fit", "cover", "important");
          img.style.setProperty("display", "block", "important");
        });
      }

      applyImageFix(catalogGrid);
      applyImageFix(dbSourceContainer);

      const allSourceCards = Array.from(
        dbSourceContainer.querySelectorAll(".database-card-source")
      );

      const searchInput = document.querySelector(
        'input[type="text"], #global-search'
      ) as HTMLInputElement;
      const countrySelect = document.getElementById(
        "filter-country"
      ) as HTMLSelectElement;
      const genreSelect = document.getElementById(
        "filter-genre"
      ) as HTMLSelectElement;
      const yearSelect = document.getElementById(
        "filter-year"
      ) as HTMLSelectElement;
      const categorySelect = document.getElementById(
        "filter-category"
      ) as HTMLSelectElement;
      const sortSelect = document.getElementById(
        "filter-sort"
      ) as HTMLSelectElement;
      const noResults = document.getElementById("no-results");

      function displayCurrentPage() {
        if (!catalogGrid) return;
        catalogGrid.innerHTML = "";

        const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
        const endIndex = startIndex + ITEMS_PER_PAGE;
        const pageCards = currentFilteredCards.slice(startIndex, endIndex);

        pageCards.forEach((sourceCard) => {
          const clonedCard = sourceCard.cloneNode(true) as HTMLElement;
          clonedCard.className = "catalog-card-wrapper";
          catalogGrid.appendChild(clonedCard);
        });

        applyImageFix(catalogGrid);
      }

      function renderPagination() {
        if (!paginationControls) return;
        paginationControls.innerHTML = "";

        const totalPages = Math.ceil(
          currentFilteredCards.length / ITEMS_PER_PAGE
        );
        if (totalPages <= 1) return;

        const maxVisible = window.innerWidth < 600 ? 3 : 5;

        const createBtn = (page: number, active = false) => {
          const button = document.createElement("button");
          button.innerText = page.toString();
          button.className = `pagination-btn ${active ? "active" : ""}`;

          button.addEventListener("click", () => {
            currentPage = page;
            displayCurrentPage();
            renderPagination();
            document
              .querySelector(".catalog-section")
              ?.scrollIntoView({ behavior: "smooth" });
          });

          return button;
        };

        const addDots = () => {
          const dots = document.createElement("span");
          dots.innerText = "...";
          dots.className = "pagination-dots";
          paginationControls.appendChild(dots);
        };

        let start = Math.max(1, currentPage - Math.floor(maxVisible / 2));
        let end = start + maxVisible - 1;

        if (end > totalPages) {
          end = totalPages;
          start = Math.max(1, end - maxVisible + 1);
        }

        // first page
        if (start > 1) {
          paginationControls.appendChild(createBtn(1, currentPage === 1));
          if (start > 2) addDots();
        }

        // middle pages
        for (let i = start; i <= end; i++) {
          paginationControls.appendChild(createBtn(i, i === currentPage));
        }

        // last page
        if (end < totalPages) {
          if (end < totalPages - 1) addDots();
          paginationControls.appendChild(
            createBtn(totalPages, currentPage === totalPages)
          );
        }
      }

      function applySorting(cards: Element[], sortValue: string): Element[] {
        const sorted = [...cards];

        switch (sortValue) {
          case "status-ongoing":
            return sorted.sort((a, b) => {
              const aVal = a.getAttribute("data-status") === "ongoing" ? 0 : 1;
              const bVal = b.getAttribute("data-status") === "ongoing" ? 0 : 1;
              return aVal - bVal;
            });

          case "status-completed":
            return sorted.sort((a, b) => {
              const aVal = a.getAttribute("data-status") !== "ongoing" ? 0 : 1;
              const bVal = b.getAttribute("data-status") !== "ongoing" ? 0 : 1;
              return aVal - bVal;
            });

          case "rating-desc":
            return sorted
              .filter((card) => card.getAttribute("data-status") !== "ongoing")
              .sort((a, b) => {
                const aR =
                  parseFloat(a.getAttribute("data-rating") || "0") || 0;
                const bR =
                  parseFloat(b.getAttribute("data-rating") || "0") || 0;
                return bR - aR;
              });

          case "rating-asc":
            return sorted
              .filter((card) => card.getAttribute("data-status") !== "ongoing")
              .sort((a, b) => {
                const aR =
                  parseFloat(a.getAttribute("data-rating") || "0") || 0;
                const bR =
                  parseFloat(b.getAttribute("data-rating") || "0") || 0;
                return aR - bR;
              });

          case "network-az":
            return sorted.sort((a, b) => {
              const aN = a.getAttribute("data-network") || "";
              const bN = b.getAttribute("data-network") || "";
              return aN.localeCompare(bN, "uk");
            });

          case "network-za":
            return sorted.sort((a, b) => {
              const aN = a.getAttribute("data-network") || "";
              const bN = b.getAttribute("data-network") || "";
              return bN.localeCompare(aN, "uk");
            });

          default:
            // Рандомне сортування для режиму за замовчуванням
            return sorted.sort(() => 0.5 - Math.random());
        }
      }

      function filterCatalog() {
        const searchQuery = searchInput
          ? searchInput.value.toLowerCase().trim()
          : "";
        const selectedCountry = countrySelect ? countrySelect.value : "all";
        const selectedGenre = genreSelect ? genreSelect.value : "all";
        const selectedYear = yearSelect ? yearSelect.value : "all";
        const selectedSort = sortSelect ? sortSelect.value : "default";
        const selectedCategory = categorySelect ? categorySelect.value : "all";

        const filtered = allSourceCards.filter((sourceCard) => {
          const titleUa = sourceCard.getAttribute("data-title") || "";
          const titleEn = sourceCard.getAttribute("data-en-title") || "";
          const country = sourceCard.getAttribute("data-country") || "";
          const year = sourceCard.getAttribute("data-year") || "";
          const category = sourceCard.getAttribute("data-category") || "";
          const genres = (sourceCard.getAttribute("data-genres") || "").split(
            ","
          );

          const matchesSearch =
            searchQuery === "" ||
            titleUa.includes(searchQuery) ||
            titleEn.includes(searchQuery);
          const matchesCountry =
            selectedCountry === "all" || country === selectedCountry;
          const matchesYear = selectedYear === "all" || year === selectedYear;
          const matchesGenre =
            selectedGenre === "all" || genres.includes(selectedGenre);

          return (
            matchesSearch &&
            matchesCountry &&
            matchesYear &&
            matchesGenre &&
            (selectedCategory === "all" || category === selectedCategory)
          );
        });

        currentFilteredCards = applySorting(filtered, selectedSort);
        currentPage = 1;
        displayCurrentPage();
        renderPagination();

        if (noResults) {
          noResults.style.display =
            currentFilteredCards.length === 0 ? "block" : "none";
        }
      }

      searchInput?.addEventListener("input", filterCatalog);
      countrySelect?.addEventListener("change", filterCatalog);
      genreSelect?.addEventListener("change", filterCatalog);
      yearSelect?.addEventListener("change", filterCatalog);
      sortSelect?.addEventListener("change", filterCatalog);
      categorySelect?.addEventListener("change", filterCatalog);

      filterCatalog();
    }

    document.addEventListener("DOMContentLoaded", initPageFeatures);
    document.addEventListener("astro:after-swap", initPageFeatures);
  </script>

