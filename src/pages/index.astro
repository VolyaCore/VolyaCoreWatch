---
import MainLayout from "../layouts/MainLayout.astro";
import MovieCard from "../components/MovieCard.astro";
import lakornsData from "../data/lakorns.json";


const latestLakorns = lakornsData.slice(0, 24);
---


<MainLayout title="VolyaCore">
  <section class="hero-carousel-section">
    <div class="carousel-container">
      <div class="carousel-track" id="carousel-track">
        {
          lakornsData
            .filter((lakorn) => lakorn.status.toLowerCase() === "ongoing")
            .map((lakorn) => (
              <div
                class="carousel-slide-wrapper carousel-active"
                data-id={lakorn.id}
              >
                <MovieCard
                  id={lakorn.id}
                  title={lakorn.title}
                  enTitle={lakorn.enTitle}
                  cover={lakorn.cover}
                  status={lakorn.status}
                  episodesCount={lakorn.episodesCount}
                  country={lakorn.country}
                  year={lakorn.year}
                  genres={lakorn.genres}
                  imdbRating={lakorn.imdbRating}
                />
              </div>
            ))
        }
      </div>

      <button
        class="carousel-nav-btn prev-btn"
        id="carousel-prev"
        aria-label="Попередній">❮</button
      >
      <button
        class="carousel-nav-btn next-btn"
        id="carousel-next"
        aria-label="Наступний">❯</button
      >

      <div class="carousel-dots" id="carousel-dots"></div>
    </div>
  </section>

  <section class="filters-section">
    <div class="filter-group">
      <label for="filter-country">Країна</label>
      <select id="filter-country" class="filter-group">
        <option value="all">Усі країни</option>
        <option value="thailand">Таїланд</option>
        <option value="korea">Південна Корея</option>
        <option value="japan">Японія</option>
        <option value="china">Китай</option>
        <option value="taiwan">Тайвань</option>
        <option value="singapore">Сінгапур</option>
        <option value="philippines">Філіппіни</option>
      </select>
    </div>

    <div class="filter-group">
      <label for="filter-genre">Жанр</label>
      <select id="filter-genre" class="filter-group">
        <option value="all">Усі жанри</option>
        <option value="romance">Романтика</option>
        <option value="drama">Драма</option>
        <option value="detective">Детектив</option>
        <option value="comedy">Комедія</option>
        <option value="crime">Кримінал</option>
        <option value="sports">Спорт</option>
        <option value="music">Музика</option>
        <option value="routine">Буденність</option>
        <option value="fantasy">Фентезі</option>
        <option value="fantastic">Фантастика</option>
        <option value="action">Бойовик</option>
        <option value="horrors">Жахи</option>
        <option value="supernatural">Надприродне</option>
        <option value="thriller">Триллер</option>
        <option value="mysticism">Містика</option>
        <option value="youth">Юність</option>
        <option value="law">Закон</option>
        <option value="melodrama">Мелодрама</option>
        <option value="business">Бізнес</option>
        <option value="food">Страви</option>
        <option value="medical">Медицина</option>
        <option value="historical">Історичне</option>
        <option value="psychological">Психологія</option>
        <option value="life">Життя</option>
        <option value="slice of life">Повседневність</option>
        <option value="fashion film">Фешн-фільм</option>
        <option value="adult">Для дорослих</option>
        <option value="sci-fi">Наукова Фантастика</option>
      </select>
    </div>

    <div class="filter-group">
      <label for="filter-format">Формат</label>
      <select id="filter-format" class="filter-group">
        <option value="all">Усі</option>
        <option value="film">Фільми</option>
        <option value="series">Серіали</option>
      </select>
    </div>

    <div class="filter-group">
      <label for="filter-sort">Сортування</label>
      <select id="filter-sort" class="filter-group">
        <option value="default">За замовчуванням</option>
        <option value="status-ongoing">В процесі спочатку</option>
        <option value="status-completed">Завершені спочатку</option>
        <option value="rating-desc">Рейтинг від найбільшого</option>
        <option value="rating-asc">Рейтинг від найменшого</option>
      </select>
    </div>

    <div class="filter-group">
      <label for="filter-category">Категорія</label>
      <select id="filter-category" class="filter-group">
        <option value="all">Усі категорії</option>
        <option value="Bl">BL</option>
        <option value="Gl">GL</option>
        <option value="Інше">Інше</option>
      </select>
    </div>

    <div class="filter-group" id="studio-filter-wrapper" style="display: none;">
      <label for="filter-studio">Тайські студії</label>
      <select id="filter-studio" class="filter-group">
        <option value="all">Усі студії</option>
        <option value="Me Mind Y">Me Mind Y</option>
        <option value="Be On Cloud">Be On Cloud</option>
        <option value="CHANGE2561">CHANGE2561</option>
        <option value="Domundi TV">Domundi TV</option>
        <option value="GMMTV">GMMTV</option>
        <option value="other">Інші</option>
      </select>
    </div>
  </section>

  <section class="catalog-section">
    <h2>Усі релізи</h2>

    <div class="movies-grid catalog-fixed-grid" id="catalog-grid">
      {
        latestLakorns.map((lakorn) => (
          <div
            class="catalog-card-wrapper"
            data-id={lakorn.id}
            data-title={lakorn.title.toLowerCase()}
            data-en-title={lakorn.enTitle ? lakorn.enTitle.toLowerCase() : ""}
            data-status={lakorn.status.toLowerCase()}
            data-country={lakorn.country}
            data-category={lakorn.categories ? lakorn.categories : ""}
            data-year={lakorn.year}
            data-genres={lakorn.genres.join(",")}
            data-rating={lakorn.imdbRating ?? ""}
            data-network={(lakorn.network || "").toLowerCase()}
          >
            <MovieCard
              id={lakorn.id}
              title={lakorn.title}
              enTitle={lakorn.enTitle}
              cover={lakorn.cover}
              status={lakorn.status}
              episodesCount={lakorn.episodesCount}
              country={lakorn.country}
              year={lakorn.year}
              genres={lakorn.genres}
              imdbRating={lakorn.imdbRating}
            />
          </div>
        ))
      }
    </div>

    <div class="pagination-container" id="pagination-controls"></div>

    <div id="hidden-full-database" style="display: none;">
      {
        lakornsData.map((lakorn) => (
          <div
            class="database-card-source"
            data-id={lakorn.id}
            data-title={lakorn.title.toLowerCase()}
            data-en-title={lakorn.enTitle ? lakorn.enTitle.toLowerCase() : ""}
            data-status={lakorn.status.toLowerCase()}
            data-country={lakorn.country}
            data-category={lakorn.categories ? lakorn.categories : ""}
            data-year={lakorn.year}
            data-genres={lakorn.genres.join(",")}
            data-rating={lakorn.imdbRating ?? ""}
            data-network={(lakorn.network || "").toLowerCase()}
          >
            <MovieCard
              id={lakorn.id}
              title={lakorn.title}
              enTitle={lakorn.enTitle}
              cover={lakorn.cover}
              status={lakorn.status}
              episodesCount={lakorn.episodesCount}
              country={lakorn.country}
              year={lakorn.year}
              genres={lakorn.genres}
              imdbRating={lakorn.imdbRating}
            />
          </div>
        ))
      }
    </div>

    <div id="no-results" class="no-results-msg" style="display: none;">
      <p>🔍 На жаль, нічого не знайдено за такими критеріями фільтрації.</p>
    </div>
  </section>

  <script>
    // Глобальні змінні
    let searchInput: HTMLInputElement | null = null;
    let allSourceCards: Element[] = [];
    let currentFilteredCards: Element[] = [];
    let currentPage = 1;
    const ITEMS_PER_PAGE = 24;
  
    // --- ЛОГІКА КАРУСЕЛІ ---
    function initCarousel() {
      const track = document.getElementById("carousel-track") as HTMLElement;
      const nextBtn = document.getElementById("carousel-next");
      const prevBtn = document.getElementById("carousel-prev");
  
      if (!track) return;
  
      let currentIndex = 0;
      let autoPlayInterval: number | null = null;
      const AUTOPLAY_DELAY = 5000; 
  
      // Функція для оновлення позиції каруселі
      function updateCarousel() {
        const slideWrapper = track.querySelector(".carousel-slide-wrapper");
        if (!slideWrapper) return;
        
        const slideWidth = slideWrapper.clientWidth;
        const gap = 20;
        track.style.transform = `translateX(-${currentIndex * (slideWidth + gap)}px)`;
      }
  
      // Функція для переходу на наступний елемент
      function nextSlide() {
        const slideWrapper = track.querySelector(".carousel-slide-wrapper");
        if (!slideWrapper) return;
        
        const slideWidth = slideWrapper.clientWidth;
        const gap = 20;
        const trackWidth = track.parentElement ? track.parentElement.clientWidth : 0;
        const visibleSlides = Math.floor(trackWidth / slideWidth);
        const maxIndex = track.children.length - visibleSlides;
  
        currentIndex++;
        
        // Якщо дошли до кінця - починаємо з першого
        if (currentIndex > maxIndex) {
          currentIndex = 0;
        }
        
        updateCarousel();
      }
  
      // Автоматична прокрутка
      function startAutoPlay() {
        if (autoPlayInterval) {
          clearInterval(autoPlayInterval);
        }
        autoPlayInterval = setInterval(nextSlide, AUTOPLAY_DELAY);
      }
  
      // Стоп автоматичної прокрутки
      function stopAutoPlay() {
        if (autoPlayInterval) {
          clearInterval(autoPlayInterval);
          autoPlayInterval = null;
        }
      }
  
      nextBtn?.addEventListener("click", () => {
        stopAutoPlay();
        nextSlide();
        startAutoPlay();
      });
  
      prevBtn?.addEventListener("click", () => {
        stopAutoPlay();
        
        const slideWrapper = track.querySelector(".carousel-slide-wrapper");
        if (!slideWrapper) return;
        
        const slideWidth = slideWrapper.clientWidth;
        const gap = 20;
        const trackWidth = track.parentElement ? track.parentElement.clientWidth : 0;
        const visibleSlides = Math.floor(trackWidth / slideWidth);
        const maxIndex = track.children.length - visibleSlides;
  
        currentIndex--;
        
        // Якщо дошли до початку - ідемо до кінця
        if (currentIndex < 0) {
          currentIndex = maxIndex;
        }
        
        updateCarousel();
        
        startAutoPlay();
      });
  
      // Стоп автоплею коли користувач ведріює карусель
      track.addEventListener("mouseenter", stopAutoPlay);
      track.addEventListener("focus", stopAutoPlay);
  
      // Запуск автоплею
      startAutoPlay();
    }
  
    // --- ЛОГІКА КАТАЛОГУ ---
    function applyImageFix(container: HTMLElement) {
      container.querySelectorAll("img").forEach((img) => {
        img.style.setProperty("width", "100%", "important");
        img.style.setProperty("height", "auto", "important");
        img.style.setProperty("aspect-ratio", "2 / 3", "important");
        img.style.setProperty("object-fit", "cover", "important");
        img.style.setProperty("display", "block", "important");
      });
    }
  
    function displayCurrentPage() {
      const catalogGrid = document.getElementById("catalog-grid");
      if (!catalogGrid) return;
      catalogGrid.innerHTML = "";
  
      const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
      const endIndex = startIndex + ITEMS_PER_PAGE;
      const pageCards = currentFilteredCards.slice(startIndex, endIndex);
  
      pageCards.forEach((sourceCard) => {
        const clonedCard = sourceCard.cloneNode(true) as HTMLElement;
        clonedCard.className = "catalog-card-wrapper";
        catalogGrid.appendChild(clonedCard);
      });
  
      applyImageFix(catalogGrid);
    }
  
    function applySorting(cards: Element[], sortValue: string): Element[] {
      const sorted = [...cards];
  
      switch (sortValue) {
        case "status-ongoing":
          return sorted.sort((a, b) => {
            const aVal = a.getAttribute("data-status") === "ongoing" ? 0 : 1;
            const bVal = b.getAttribute("data-status") === "ongoing" ? 0 : 1;
            return aVal - bVal;
          });
  
        case "status-completed":
          return sorted.sort((a, b) => {
            const aVal = a.getAttribute("data-status") !== "ongoing" ? 0 : 1;
            const bVal = b.getAttribute("data-status") !== "ongoing" ? 0 : 1;
            return aVal - bVal;
          });
  
        case "rating-desc":
          return sorted
            .filter((card) => card.getAttribute("data-status") !== "ongoing")
            .sort((a, b) => {
              const aR = parseFloat(a.getAttribute("data-rating") || "0") || 0;
              const bR = parseFloat(b.getAttribute("data-rating") || "0") || 0;
              return bR - aR;
            });
  
        case "rating-asc":
          return sorted
            .filter((card) => card.getAttribute("data-status") !== "ongoing")
            .sort((a, b) => {
              const aR = parseFloat(a.getAttribute("data-rating") || "0") || 0;
              const bR = parseFloat(b.getAttribute("data-rating") || "0") || 0;
              return aR - bR;
            });
  
        case "network-az":
          return sorted.sort((a, b) => {
            const aN = a.getAttribute("data-network") || "";
            const bN = b.getAttribute("data-network") || "";
            return aN.localeCompare(bN, "uk");
          });
  
        case "network-za":
          return sorted.sort((a, b) => {
            const aN = a.getAttribute("data-network") || "";
            const bN = b.getAttribute("data-network") || "";
            return bN.localeCompare(aN, "uk");
          });
  
        default:
          return sorted.sort(() => 0.5 - Math.random());
      }
    }
  
    function filterCatalog() {
      const q = searchInput && searchInput.value ? searchInput.value.toLowerCase().trim() : "";
      
      const countrySelect = document.getElementById("filter-country") as HTMLSelectElement | null;
      const genreSelect = document.getElementById("filter-genre") as HTMLSelectElement | null;
      const formatSelect = document.getElementById("filter-format") as HTMLSelectElement | null;
      const categorySelect = document.getElementById("filter-category") as HTMLSelectElement | null;
      const sortSelect = document.getElementById("filter-sort") as HTMLSelectElement | null;
      const studioSelect = document.getElementById("filter-studio") as HTMLSelectElement | null;
  
      const c = countrySelect ? countrySelect.value : "all";
      const g = genreSelect ? genreSelect.value : "all";
      const format = formatSelect ? formatSelect.value : "all";
      const cat = categorySelect ? categorySelect.value : "all";
      const s = sortSelect ? sortSelect.value : "default";
      const studio = studioSelect ? studioSelect.value : "all";
  
      const thaiStudios = [
        "me mind y",
        "be on cloud",
        "change2561",
        "domundi tv",
        "gmmtv",
      ];
  
      const filtered = allSourceCards.filter((card) => {
        const titleUa = card.getAttribute("data-title") || "";
        const titleEn = card.getAttribute("data-en-title") || "";
        const title = titleUa + titleEn;
        const country = card.getAttribute("data-country") || "";
        const genres = (card.getAttribute("data-genres") || "").split(",");
        const network = (card.getAttribute("data-network") || "").toLowerCase().trim();
  
        const isFilm = genres.includes("film");
        let matchFormat = true;
        if (format === "film") {
          matchFormat = isFilm;
        } else if (format === "series") {
          matchFormat = !isFilm;
        }
  
        const matchBase =
          (q === "" || title.includes(q)) &&
          (c === "all" || country === c) &&
          (g === "all" || genres.includes(g)) &&
          (cat === "all" || card.getAttribute("data-category") === cat);
  
        let matchStudio = true;
        if (c === "thailand" && studio !== "all") {
          matchStudio =
            studio === "other"
              ? !thaiStudios.includes(network)
              : network === studio.toLowerCase();
        }
  
        return matchBase && matchStudio && matchFormat;
      });
  
      currentFilteredCards = applySorting(filtered, s);
      currentPage = 1;
      displayCurrentPage();
      renderPagination();
  
      const noResults = document.getElementById("no-results");
      if (noResults) {
        noResults.style.display = currentFilteredCards.length === 0 ? "block" : "none";
      }
    }
  
    function renderPagination() {
      const paginationControls = document.getElementById("pagination-controls");
      if (!paginationControls) return;
  
      paginationControls.innerHTML = "";
  
      const totalPages = Math.ceil(currentFilteredCards.length / ITEMS_PER_PAGE);
  
      if (totalPages <= 1) {
        paginationControls.style.display = "none";
        return;
      }
  
      paginationControls.style.display = "flex";
  
      for (let i = 1; i <= totalPages; i++) {
        const btn = document.createElement("button");
        btn.innerText = i.toString();
        btn.className = `pagination-btn ${i === currentPage ? "active" : ""}`;
  
        btn.addEventListener("click", () => {
          currentPage = i;
          displayCurrentPage();
          renderPagination();
          document.querySelector(".catalog-section")?.scrollIntoView({ behavior: "smooth" });
        });
  
        paginationControls.appendChild(btn);
      }
    }
  
    function toggleStudioVisibility() {
      const studioWrapper = document.getElementById("studio-filter-wrapper");
      const countrySelect = document.getElementById("filter-country") as HTMLSelectElement | null;
      const studioSelect = document.getElementById("filter-studio") as HTMLSelectElement | null;
  
      if (!studioWrapper || !countrySelect || !studioSelect) return;
  
      const countryValue = countrySelect.value || "all";
  
      if (countryValue === "thailand") {
        studioWrapper.style.display = "flex";
      } else {
        studioWrapper.style.display = "none";
        studioSelect.value = "all";
        filterCatalog();
      }
    }
  
    function initPageFeatures() {
      const dbSourceContainer = document.getElementById("hidden-full-database");
      if (!dbSourceContainer) return;
  
      searchInput = document.querySelector("#global-search") as HTMLInputElement | null;
      allSourceCards = Array.from(
        dbSourceContainer.querySelectorAll(".database-card-source")
      );
  
      if (searchInput) {
        searchInput.addEventListener("input", filterCatalog);
      }
  
      const countrySelect = document.getElementById("filter-country") as HTMLSelectElement | null;
      const genreSelect = document.getElementById("filter-genre") as HTMLSelectElement | null;
      const formatSelect = document.getElementById("filter-format") as HTMLSelectElement | null;
      const categorySelect = document.getElementById("filter-category") as HTMLSelectElement | null;
      const sortSelect = document.getElementById("filter-sort") as HTMLSelectElement | null;
      const studioSelect = document.getElementById("filter-studio") as HTMLSelectElement | null;
  
      if (countrySelect) {
        countrySelect.addEventListener("change", filterCatalog);
        countrySelect.addEventListener("change", toggleStudioVisibility);
        toggleStudioVisibility();
      }
      if (genreSelect) genreSelect.addEventListener("change", filterCatalog);
      if (formatSelect) formatSelect.addEventListener("change", filterCatalog);
      if (categorySelect) categorySelect.addEventListener("change", filterCatalog);
      if (sortSelect) sortSelect.addEventListener("change", filterCatalog);
      if (studioSelect) studioSelect.addEventListener("change", filterCatalog);
  
      initCarousel();
      filterCatalog();
    }
  
    document.addEventListener("DOMContentLoaded", initPageFeatures);
    document.addEventListener("astro:after-swap", initPageFeatures);
  
    document.addEventListener("search-trigger", ((e: CustomEvent) => {
      if (searchInput) {
        searchInput.value = e.detail;
        filterCatalog();
      }
    }) as EventListener);
  </script>
</MainLayout>

  <style is:global>
    .pagination-container {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      margin: 40px auto 10px auto;
      width: 100%;
      max-width: 1200px;
    }

    .pagination-btn {
      background-color: #0f172a;
      color: #94a3b8;
      border: 1px solid rgba(99, 102, 241, 0.2);
      padding: 10px 16px;
      border-radius: 8px;
      cursor: pointer;
      font-weight: 600;
      font-size: 14px;
      transition: all 0.25s ease;
    }

    .pagination-btn:hover {
      background-color: #1e1b4b;
      border-color: #6366f1;
      color: #fff;
    }

    .pagination-btn.active {
      background-color: #6366f1;
      color: #fff;
      border-color: #6366f1;
      box-shadow: 0 0 12px rgba(99, 102, 241, 0.4);
    }

    :global([data-theme="light"]) .pagination-btn {
      background-color: #e2e8f0;
      color: #0f172a;
      border-color: rgba(15, 23, 42, 0.15);
    }
    :global([data-theme="light"]) .pagination-btn:hover {
      background-color: #cbd5e1;
    }
    :global([data-theme="light"]) .pagination-btn.active {
      background-color: #0f172a;
      color: #fff;
      border-color: #0f172a;
    }

    .catalog-fixed-grid {
      display: grid !important;
      grid-template-columns: repeat(4, 1fr) !important;
      gap: 25px !important;
    }

    @media (max-width: 1024px) {
      .catalog-fixed-grid {
        grid-template-columns: repeat(3, 1fr) !important;
      }
    }

    @media (max-width: 600px) {
      .catalog-fixed-grid {
        grid-template-columns: repeat(2, 1fr) !important;
        gap: 12px !important;
      }
    }

    .filters-section {
      display: flex;
      gap: 20px;
      background-color: var(--bg-card) !important;
      padding: 20px;
      border-radius: 12px;
      border: 1px solid var(--border-color);
      margin-top: 30px;
      flex-wrap: wrap;
      transition:
        background-color 0.3s ease,
        border-color 0.3s ease;
    }
    [data-theme="light"] .filters-section {
      display: flex;
      gap: 20px;
      background-color: #7c9bcc !important;
    }
    .filter-group {
      display: flex;
      flex-direction: column;
      gap: 8px;
      flex: 1;
      min-width: 140px;
    }
    .filter-group label {
      font-size: 13px;
      font-weight: 700;
      color: var(--text-muted) !important;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .filter-group select {
      background-color: var(--bg-select) !important;
      border: 1px solid var(--border-color) !important;
      color: var(--text-primary) !important;
      padding: 10px 14px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 500;
      cursor: pointer;
      outline: none;
      width: 100%;
    }
    .filter-group select:focus {
      border-color: #6366f1 !important;
    }

    .catalog-section {
      margin-top: 40px;
    }
    .catalog-section h2 {
      font-size: 22px;
      font-weight: 600;
      margin-bottom: 25px;
      border-left: 4px solid #6366f1;
      padding-left: 12px;
      color: var(--text-primary) !important;
    }

    .catalog-card-wrapper {
      display: flex;
      flex-direction: column;
      width: 100%;
    }

    .no-results-msg {
      text-align: center;
      padding: 40px;
      color: var(--text-muted);
      font-size: 16px;
      background-color: var(--bg-card);
      border-radius: 12px;
      border: 1px solid var(--border-color);
    }

    .hero-carousel-section {
      width: 100%;
      margin: 1.5rem auto;
      box-sizing: border-box;
      padding: 0 10px;
    }

