---
import MainLayout from "../layouts/MainLayout.astro";
import MovieCard from "../components/MovieCard.astro";
import lakornsData from "../data/lakorns.json";
---


<MainLayout title="Мої списки — VolyaCore">
  <div class="watchlist-container">
    <h1>🍿 Мої списки перегляду</h1>

    <div class="watchlist-tabs">
      <button class="w-tab-btn active" data-watchlist-filter="favorite">
        ❤️ Сподобалось
      </button>
      <button class="w-tab-btn" data-watchlist-filter="watched">
        ✅ Переглянуто
      </button>
      <button class="w-tab-btn" data-watchlist-filter="later">
        📌 На потім
      </button>
      <button class="w-tab-btn" data-watchlist-filter="watching">
        🍿 Дивлюсь
      </button>
    </div>

    <div class="watchlist-grid" id="watchlist-grid">
      {
        lakornsData.map((lakorn) => (
          <div class="watchlist-item-wrapper hidden" data-lakorn-id={lakorn.id}>
            <MovieCard {...lakorn} />
          </div>
        ))
      }
    </div>

    <div class="empty-state hidden" id="empty-state">
      <div class="empty-content">
        <!-- <div class="empty-icon">🍿</div> -->
        <p class="empty-text">
          У цьому списку поки що немає лакорнів.<br>
          Додай щось під час перегляду! 
        </p>
        <a href="/" class="go-catalog-btn">
           Перейти до каталогу
        </a>
      </div>
    </div>
  </div>
</MainLayout>

<script :load>
  function renderWatchlist() {
    const tabs = document.querySelectorAll(".w-tab-btn");
    const grid = document.getElementById("watchlist-grid");
    const emptyState = document.getElementById("empty-state");
    const cardWrappers = document.querySelectorAll(".watchlist-item-wrapper");

    if (!grid || !emptyState) return;

    function filterItems(statusType) {
      let visibleCount = 0;

      cardWrappers.forEach(wrapper => {
        const lakornId = wrapper.getAttribute("data-lakorn-id");
        const savedStatus = localStorage.getItem("lakorn_status_" + lakornId);

        if (savedStatus === statusType) {
          wrapper.classList.remove("hidden");
          visibleCount++;
        } else {
          wrapper.classList.add("hidden");
        }
      });

      if (visibleCount === 0) {
        grid.classList.add("hidden");
        emptyState.classList.remove("hidden");
      } else {
        grid.classList.remove("hidden");
        emptyState.classList.add("hidden");
      }
    }

    tabs.forEach(tab => {
      tab.addEventListener("click", () => {
        tabs.forEach(t => t.classList.remove("active"));
        tab.classList.add("active");
        const filter = tab.getAttribute("data-watchlist-filter");
        if (filter) filterItems(filter);
      });
    });

    const activeTab = document.querySelector(".w-tab-btn.active");
    const initialFilter = activeTab ? activeTab.getAttribute("data-watchlist-filter") : "favorite";
    filterItems(initialFilter);

    const searchInputElement = document.querySelector("#global-search");
    if (searchInputElement) {
      if (searchInputElement instanceof HTMLInputElement) {
        searchInputElement.addEventListener("input", function() {
          const query = searchInputElement.value;
          if (query && query.trim() !== "") {
            window.location.assign("/?search=" + encodeURIComponent(query.trim()));
          }
        });

        searchInputElement.addEventListener("focus", function() {
          window.location.assign("/");
        });
      }
    }
  }

  renderWatchlist();
  document.addEventListener("astro:after-swap", renderWatchlist);
</script>


<style>
  .watchlist-container {
    padding-top: 0 !important;
    padding: 40px 20px;
    max-width: 1400px;
    margin: 0 auto;
  }

  .watchlist-container h1 {
    font-size: 32px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 30px;
    text-align: center;
  }

  .watchlist-tabs {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-bottom: 30px;
    flex-wrap: wrap;
  }

  .w-tab-btn {
    background-color: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.05);
    color: #94a3b8;
    padding: 10px 24px;
    border-radius: 25px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
  }

  .w-tab-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(255, 255, 255, 0.1);
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 0;
  }

  .w-tab-btn:hover::before {
    opacity: 1;
  }

  .w-tab-btn:hover {
    transform: translateY(-3px);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.2);
  }

  .w-tab-btn:active {
    transform: translateY(-1px);
  }

  .w-tab-btn span {
    position: relative;
    z-index: 1;
  }

  .w-tab-btn[data-watchlist-filter="favorite"].active {
    background-color: #ef4444;
    border-color: #ef4444;
    color: white;
    box-shadow: 0 6px 20px rgba(239, 68, 68, 0.5), 0 0 0 3px rgba(239, 68, 68, 0.2);
    transform: translateY(-3px);
    animation: pulse-red 2s infinite;
  }

  .w-tab-btn[data-watchlist-filter="later"].active {
    background-color: #3b82f6;
    border-color: #3b82f6;
    color: white;
    box-shadow: 0 6px 20px rgba(59, 130, 246, 0.5), 0 0 0 3px rgba(59, 130, 246, 0.2);
    transform: translateY(-3px);
    animation: pulse-blue 2s infinite;
  }

  .w-tab-btn[data-watchlist-filter="watching"].active {
    background-color: #10b981;
    border-color: #10b981;
    color: white;
    box-shadow: 0 6px 20px rgba(16, 185, 129, 0.5), 0 0 0 3px rgba(16, 185, 129, 0.2);
    transform: translateY(-3px);
    animation: pulse-green 2s infinite;
  }

  .w-tab-btn[data-watchlist-filter="watched"].active {
    background-color: #8b5cf6;
    border-color: #8b5cf6;
    color: white;
    box-shadow: 0 6px 20px rgba(139, 92, 246, 0.5), 0 0 0 3px rgba(139, 92, 246, 0.2);
    transform: translateY(-3px);
    animation: pulse-purple 2s infinite;
  }

  @keyframes pulse-red {
    0%, 100% { box-shadow: 0 6px 20px rgba(239, 68, 68, 0.5), 0 0 0 3px rgba(239, 68, 68, 0.2); }
    50% { box-shadow: 0 6px 25px rgba(239, 68, 68, 0.7), 0 0 0 4px rgba(239, 68, 68, 0.3); }
  }

  @keyframes pulse-blue {
    0%, 100% { box-shadow: 0 6px 20px rgba(59, 130, 246, 0.5), 0 0 0 3px rgba(59, 130, 246, 0.2); }
    50% { box-shadow: 0 6px 25px rgba(59, 130, 246, 0.7), 0 0 0 4px rgba(59, 130, 246, 0.3); }
  }

  @keyframes pulse-green {
    0%, 100% { box-shadow: 0 6px 20px rgba(16, 185, 129, 0.5), 0 0 0 3px rgba(16, 185, 129, 0.2); }
    50% { box-shadow: 0 6px 25px rgba(16, 185, 129, 0.7), 0 0 0 4px rgba(16, 185, 129, 0.3); }
  }

  @keyframes pulse-purple {
    0%, 100% { box-shadow: 0 6px 20px rgba(139, 92, 246, 0.5), 0 0 0 3px rgba(139, 92, 246, 0.2); }
    50% { box-shadow: 0 6px 25px rgba(139, 92, 246, 0.7), 0 0 0 4px rgba(139, 92, 246, 0.3); }
  }

  .watchlist-grid {
    display: grid;
    grid-template-columns: repeat(4, 240px);
    gap: 28px;
    justify-content: center;
  }

  @media (min-width: 1400px) {
    .watchlist-grid {
      grid-template-columns: repeat(4, 280px);
      gap: 32px;
    }
  }

  @media (min-width: 1200px) {
    .watchlist-grid {
      grid-template-columns: repeat(4, 260px);
      gap: 30px;
    }
  }

  @media (min-width: 1024px) {
    .watchlist-grid {
      grid-template-columns: repeat(4, 240px);
      gap: 28px;
    }
  }

  @media (max-width: 1023px) {
    .watchlist-grid {
      grid-template-columns: repeat(3, 220px);
      gap: 24px;
    }
  }

  @media (max-width: 767px) {
    .watchlist-grid {
      grid-template-columns: repeat(2, 200px);
      gap: 20px;
    }
  }

  @media (max-width: 549px) {
    .watchlist-grid {
      grid-template-columns: repeat(2, 170px);
      gap: 18px;
    }
  }

  @media (max-width: 379px) {
    .watchlist-grid {
      grid-template-columns: repeat(2, 150px);
      gap: 16px;
    }
  }

  .watchlist-item-wrapper.hidden,
  .watchlist-grid.hidden,
  .empty-state.hidden {
    display: none !important;
  }

  .watchlist-grid :global(.movie-card div:last-child p),
  .watchlist-grid :global(.episodes-count) {
    display: none !important;
  }

  /* 🌟 ПІДВІДНЕНА EMPTY STATE */
  .empty-state {
    text-align: center;
    padding: 80px 20px;
    background-color: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 20px;
    max-width: 600px;
    margin: 40px auto 0;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.4);
  }

  .empty-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .empty-icon {
    font-size: 80px;
    opacity: 0.6;
    margin-bottom: 10px;
  }

  .empty-text {
    color: #94a3b8;
    font-size: 18px;
    line-height: 1.6;
    margin: 0;
    max-width: 450px;
  }

  .go-catalog-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
    color: white;
    text-decoration: none;
    padding: 16px 36px;
    border-radius: 35px;
    font-weight: 700;
    font-size: 16px;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(37, 99, 235, 0.4);
    margin-top: 20px;
  }

  .go-catalog-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(37, 99, 235, 0.6);
  }

  @media (max-width: 480px) {
    .w-tab-btn {
      padding: 8px 16px;
      font-size: 14px;
      flex: 1;
      text-align: center;
      min-width: 120px;
    }

    .empty-text {
      font-size: 16px;
    }

    .go-catalog-btn {
      padding: 14px 28px;
      font-size: 15px;
    }
  }
</style>