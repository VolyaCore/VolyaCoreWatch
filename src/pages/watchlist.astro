---
import MainLayout from "../layouts/MainLayout.astro";
import MovieCard from "../components/MovieCard.astro";
import lakornsData from "../data/lakorns.json";
---

<MainLayout title="Мої списки — VolyaCore">
  <div class="watchlist-container">
    <h1>🍿 Мої списки перегляду</h1>

    <div class="watchlist-tabs">
      <button class="w-tab-btn active" data-watchlist-filter="favorite">
        ❤️ Сподобалось
      </button>
      <button class="w-tab-btn" data-watchlist-filter="watched">
        ✅ Переглянуто
      </button>
      <button class="w-tab-btn" data-watchlist-filter="later">
        📌 На потім
      </button>
      <button class="w-tab-btn" data-watchlist-filter="watching">
        🍿 Дивлюсь
      </button>
    </div>

    <div class="watchlist-grid" id="watchlist-grid">
      {
        lakornsData.map((lakorn) => (
          <div class="watchlist-item-wrapper hidden" data-lakorn-id={lakorn.id}>
            <MovieCard {...lakorn} />
          </div>
        ))
      }
    </div>

    <div class="empty-state hidden" id="empty-state">
      <p>
        У цьому списку поки що немає лакорнів. Додай щось під час перегляду! ✨
      </p>
      <a href="/" class="go-catalog-btn">Перейти до каталогу</a>
    </div>
  </div>
</MainLayout>

<script :load>
  function renderWatchlist() {
    var tabs = document.querySelectorAll(".w-tab-btn");
    var grid = document.getElementById("watchlist-grid");
    var emptyState = document.getElementById("empty-state");
    var cardWrappers = document.querySelectorAll(".watchlist-item-wrapper");

    if (!grid || !emptyState || cardWrappers.length === 0) return;

    function filterItems(statusType) {
      var visibleCount = 0;

      for (var i = 0; i < cardWrappers.length; i++) {
        var wrapper = cardWrappers[i];
        var lakornId = wrapper.getAttribute("data-lakorn-id");
        var savedStatus = localStorage.getItem("lakorn_status_" + lakornId);

        if (savedStatus === statusType) {
          wrapper.classList.remove("hidden");
          visibleCount++;
        } else {
          wrapper.classList.add("hidden");
        }
      }

      if (visibleCount === 0) {
        grid.classList.add("hidden");
        emptyState.classList.remove("hidden");
      } else {
        grid.classList.remove("hidden");
        emptyState.classList.add("hidden");
      }
    }

    for (var j = 0; j < tabs.length; j++) {
      var tab = tabs[j];
      tab.addEventListener("click", function() {
        for (var k = 0; k < tabs.length; k++) {
          tabs[k].classList.remove("active");
        }
        tab.classList.add("active");

        var filter = tab.getAttribute("data-watchlist-filter");
        if (filter) filterItems(filter);
      });
    }

    var activeTab = document.querySelector(".w-tab-btn.active");
    var defaultFilter = activeTab ? activeTab.getAttribute("data-watchlist-filter") : "favorite";
    filterItems(defaultFilter || "favorite");

    var searchInputElement = document.querySelector("#global-search");
    if (searchInputElement) {
      if (searchInputElement instanceof HTMLInputElement) {
        searchInputElement.addEventListener("input", function() {
          var query = searchInputElement.value;
          if (query && query.trim() !== "") {
            window.location.assign("/?search=" + encodeURIComponent(query.trim()));
          }
        });

        searchInputElement.addEventListener("focus", function() {
          window.location.assign("/");
        });
      }
    }
  }

  document.addEventListener("DOMContentLoaded", renderWatchlist);
  document.addEventListener("astro:after-swap", renderWatchlist);
</script>

<style>
  .watchlist-container {
    padding-top: 0 !important;
    padding: 40px 20px;
    max-width: 1400px;
    margin: 0 auto;
  }

  .watchlist-container h1 {
    font-size: 32px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 30px;
    text-align: center;
  }

  .watchlist-tabs {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-bottom: 30px;
    flex-wrap: wrap;
  }

  .w-tab-btn {
    background-color: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.05);
    color: #94a3b8;
    padding: 10px 24px;
    border-radius: 25px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .w-tab-btn:hover {
    transform: translateY(-2px);
    color: #fff;
  }

  .w-tab-btn[data-watchlist-filter="favorite"].active {
    background-color: #ef4444;
    border-color: #ef4444;
    color: white;
    box-shadow: 0 4px 15px rgba(239, 68, 68, 0.4);
  }

  .w-tab-btn[data-watchlist-filter="later"].active {
    background-color: #3b82f6;
    border-color: #3b82f6;
    color: white;
    box-shadow: 0 4px 15px rgba(59, 130, 246, 0.4);
  }

  .w-tab-btn[data-watchlist-filter="watching"].active {
    background-color: #10b981;
    border-color: #10b981;
    color: white;
    box-shadow: 0 4px 15px rgba(16, 185, 129, 0.4);
  }

  .w-tab-btn[data-watchlist-filter="watched"].active {
    background-color: #8b5cf6;
    border-color: #8b5cf6;
    color: white;
    box-shadow: 0 4px 15px rgba(139, 92, 246, 0.4);
  }

  /* 4 КАРТКИ В РЯД — фіксований розмір 240px */
  .watchlist-grid {
    display: grid;
    grid-template-columns: repeat(4, 240px);
    gap: 28px;
    justify-content: center;
  }

  @media (min-width: 1400px) {
    .watchlist-grid {
      grid-template-columns: repeat(4, 280px);
      gap: 32px;
    }
  }

  @media (min-width: 1200px) {
    .watchlist-grid {
      grid-template-columns: repeat(4, 260px);
      gap: 30px;
    }
  }

  @media (min-width: 1024px) {
    .watchlist-grid {
      grid-template-columns: repeat(4, 240px);
      gap: 28px;
    }
  }

  @media (max-width: 1023px) {
    .watchlist-grid {
      grid-template-columns: repeat(3, 220px);
      gap: 24px;
    }
  }

  @media (max-width: 767px) {
    .watchlist-grid {
      grid-template-columns: repeat(2, 200px);
      gap: 20px;
    }
  }

  @media (max-width: 549px) {
    .watchlist-grid {
      grid-template-columns: repeat(2, 170px);
      gap: 18px;
    }
  }

  @media (max-width: 379px) {
    .watchlist-grid {
      grid-template-columns: repeat(2, 150px);
      gap: 16px;
    }
  }

  .watchlist-item-wrapper.hidden,
  .watchlist-grid.hidden,
  .empty-state.hidden {
    display: none !important;
  }

  .watchlist-grid :global(.movie-card div:last-child p),
  .watchlist-grid :global(.episodes-count) {
    display: none !important;
  }

  .empty-state {
    text-align: center;
    padding: 60px 20px;
    background-color: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 16px;
    max-width: 500px;
    margin: 40px auto 0;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
  }

  .empty-state p {
    color: #94a3b8;
    font-size: 16px;
    margin-bottom: 25px;
    line-height: 1.6;
    display: block !important;
  }

  .go-catalog-btn {
    display: inline-block;
    background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
    color: white;
    text-decoration: none;
    padding: 12px 26px;
    border-radius: 30px;
    font-weight: 600;
    font-size: 14px;
    transition: all 0.25s ease;
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
  }

  .go-catalog-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(37, 99, 235, 0.5);
  }

  @media (max-width: 480px) {
    .w-tab-btn {
      padding: 8px 16px;
      font-size: 14px;
      flex: 1;
      text-align: center;
      min-width: 120px;
    }
  }
</style>
