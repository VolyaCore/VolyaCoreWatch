  title = "VolyaCore — Переклад з субтитрами азійських BL, GL, гет к-драм/пісень та інше",
  description = "Офіційний сайт VolyaCore. Переклад з субтитрами азійських BL, GL, гет к-драм/пісень та інше.",
} = Astro.props;

const siteUrl = "https://volyacore.com/";
const siteName = "VolyaCore";
---

